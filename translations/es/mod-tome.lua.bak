t("range %d; cd %d", "%d; cd %d", "tformat")
t("Rune: Shielding", "Runa: Shielding", "talent name")
t("Activate the rune to create a protective shield absorbing at most %d damage for %d turns.", "Activar la runa para crear un escudo protector absorbiendo a la mayoría %d daño para %d vueltas.", "tformat")
t("absorb %d; dur %d; cd %d", "%d; dur %d; cd %d", "tformat")
t("Rune: Reflection Shield", "Rune: Reflection Escudo", "talent name")
t("Activate the rune to create a protective shield absorbing and reflecting at most %d damage for %d turns.", "Activar la runa para crear un escudo protector absorbiendo y reflexionando en la mayoría de %d daño para %d vueltas.", "tformat")
t("absorb and reflect %d; dur %d; cd %d", "absorber y reflejar %d; dur %d; cd %d", "tformat")
