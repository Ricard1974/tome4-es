-- section "mod-tome/data/timed_effects/floor.lua"

-- new text
t("Icy Floor", "Icy Floor", "floorEffect desc")
t("The target is walking on an icy floor. Increasing movement speed by 20%, providing +20% cold damage piercing and -30% stun immunity.", "El objetivo estás caminando en un piso helado. Aumentar la velocidad de movimiento en un 20%, proporcionando +20% de daño en frío perforación y -30% de inmunidad.", "_t")
t("Font of Life", "Fuente de Vida", "floorEffect desc")
t("The target is near a font of life, granting %+0.2f life regeneration, %+0.2f equilibrium regeneration, %+0.2f stamina regeneration and %+0.2f psi regeneration.  (Only living creatures benefit.)", "El objetivo estás cerca de una fuente de vida, otorgando %+0.2f regeneración de vida, %+0.2f regeneración de equilibrio, %+0.2f regeneración de resistencia y %+0.2f regeneración psi. (Sólo las criaturas vivientes se benefician)", "tformat")
t("Spellblaze Scar", "Escarpado de gas", "floorEffect desc")
t("The target is near a spellblaze scar, granting +25% spell critical chance, +10% fire and blight damage but critical spells will drain arcane forces.", "El objetivo estás cerca de una cicatriz de ortografía, concediendo +25% deletreo de riesgo crítico, +10% de fuego y daño de la luz, pero hechizos críticos drenará fuerzas arcanas.", "_t")
t("Blighted Soil", "Blighted Soil", "floorEffect desc")
t("The target is walking on blighted soil, reducing diseases resistance by 60% and giving all attacks a 40% chance to infect the target with a random disease (can only happen once per turn).", "El objetivo es caminar sobre suelos deslumbrados, reduciendo la resistencia a las enfermedades en un 60% y dando a todos los ataques una oportunidad del 40% para infectar el objetivo con una enfermedad aleatoria (puedes ocurrir sólo una vez por turno).", "_t")
t("Glimmerstone", "Glimmerstone", "floorEffect desc")
t("The target is affected by a glimmerstone, its next attack will try to daze.", "El objetivo se ve afectado por una lápida, tu próximo ataque tratará de desgarrar.", "_t")
t("Protective Aura", "Protective Aura", "floorEffect desc")
t("The target is near a protective aura, granting +%d armour and +%d physical save.", "El objetivo estás cerca de un aura protectora, otorgando + %d armadura y +%d ahorro físico.", "tformat")
t("Antimagic Bush", "Antimago Bush", "floorEffect desc")
t("The target is near an antimagic bush, granting +20%% nature damage, +20%% nature resistance penetration and -%d spellpower.", "El objetivo estás cerca de un arbusto antimagico, concediendo +20%% de daño natural, +20%% de resistencia a la naturaleza penetración y - fuerza de hechizo.%d", "tformat")
t("Necrotic Air", "Necrotic Air", "floorEffect desc")
t("The target is in a zone of necrotic air, granting -40% healing mod. Undead creatures also get +15% to all resistances.", "El objetivo estás en una zona de aire necrótico, otorgando -40% mod curativo. Las criaturas muertas también obtienen +15% a todas las resistencias.", "_t")
t("Whistling Vortex", "Whistling Vortex", "floorEffect desc")
t("The target is in a whistling vortex, granting +%d ranged defense, -%d ranged accuracy and incoming projectiles are 30%% slower.", "El objetivo estás en un vórtice látigo, otorgando +%d defensa ampliada, -%d de precisión y los proyectiles entrantes son 30%% más lento.", "tformat")
t("Fell Aura", "Fell Aura", "floorEffect desc")
t("The target is surrounded by a fell aura, granting 40% critical damage bonus but -20% to all resistances.", "El objetivo estás rodeado por un aura caído, otorgando un 40% de prima por daños críticos pero -20% a todas las resistencias.", "_t")
t("Slimey Pool", "Slimey Pool", "floorEffect desc")
t("The target is walking on slime. Decreasing movement speed by 20% and dealing 20 slime damage to any creatures attacking it.", "El objetivo es caminar sobre el deslizamiento. Disminuir la velocidad del movimiento en un 20% y tratar 20 desprestigios a cualquier criatura que lo ataque.", "_t")

