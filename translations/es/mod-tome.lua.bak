-- section "mod-tome/data/general/npcs/snow-giant.lua"

-- new text
t("giant", "gigante", "entity type")
t("ice", "hielo", "entity subtype")
t("snow giant", "nieve gigante", "entity name")
t("A towering creature, humanoid but huge. It wields a giant maul and does not look friendly.", "Una criatura imponente, humanoide pero enorme. Maneja un maul gigante y no parece amistoso.", "_t")
t("snow giant thunderer", "tormenta gigante de nieve", "entity name")
t("A towering creature, humanoid but huge. It wields a giant maul and does not look friendly. Lightning crackles over its body.", "Una criatura imponente, humanoide pero enorme. Maneja un maul gigante y no parece amistoso. Relámpagos sobre tu cuerpo.", "_t")
t("snow giant boulder thrower", "lanzador gigante de nieve", "entity name")
t("snow giant chieftain", "de nieve gigante", "entity name")
t("Burb the snow giant champion", "Burb el campeón de la nieve gigante", "entity name")
t("A maddened, enraged snow giant that towers over his comrades. You've heard legends mentioning this particular monstrosity; they say that when he's not rampaging around frothing at the mouth, he sits, almost childlike, engraving stories and mysterious patterns on any flat stone surface he can find.", "Un gigante de nieve enojado y enfurecido que se eleva sobre sus camaradas. Ustedes han oído leyendas que mencionan esta monstruosidad particular; dicen que cuando no estás dando vueltas alrededor del frothing en la boca, se sienta, casi infantil, grabando historias y patrones misteriosos en cualquier superficie plana de piedra que pueda encontrar.", "_t")

