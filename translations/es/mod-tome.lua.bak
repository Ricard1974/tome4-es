t("damage %d; dur %d; cd %d", "daño %d; dur %d; cd %d", "tformat")
t("Rune: Acid Wave", "Rune: Ácido Ola", "talent name")
t("Rune: Manasurge", "Runa: Manasurge", "talent name")
t("Your negative mana regeneration rate is unaffected by the rune.", "Tu tasa negativa de regeneración de maná no es afectada por la runa.", "logPlayer")
t("Your nonexistant mana regeneration rate is unaffected by the rune.", "Tu tasa de regeneración de maná no existente no es afectada por la runa.", "logPlayer")
t("regen %d%% over %d turns; mana %d; cd %d", "regen %d %% over %d turns; mana %d; cd %d", "tformat")
t("Rune of the Rift", "Rune de Rift", "talent name")
t("%s is immune!", "¡Es inmune!%s", "logSeen")
t("%s resists!", "%s resiste!", "logSeen")
t("Something has prevented the timetravel.", "Algo ha impedido el recorrido temporal.", "logPlayer")
t("temporal instability", "inestabilidad temporal", "_t")
t("%s has moved forward in time!", "%s ha avanzado a tiempo!", "logSeen")
t("%0.2f temporal damage, removed from time %d turns", "%0.2f daño temporal, eliminado del tiempo %d vueltas", "tformat")
t("Rune: Blink", "Rune: Parpadeo", "talent name")
t("Activate the rune to teleport up to %d spaces within line of sight.  Afterwards you stay out of phase for %d turns. In this state all new negative status effects duration is reduced by %d%%, your defense is increased by %d and all your resistances by %d%%.", "Activar la runa para teletransportar hasta %d espacios dentro de la línea de visión. Después te mantienes fuera de la fase para giras %d. En este estado, la duración de los efectos negativos del estado se reduce en %d%%, tu defensa se incrementa por %d y todas sus resistencias por %d %%.", "tformat")
t("range %d; phase %d; cd %d", "rango %d; fase %d; cd %d", "tformat")
t("Rune: Ethereal", "Runa: Etéreo", "talent name")
t("power %d; resist %d%%; move %d%%; dur %d; cd %d", "%d; resist %d%%; move %d%%; dur %d; cd %d", "tformat")
t("Rune: Stormshield", "Runa: Stormshield", "talent name")
t("threshold %d; blocks %d; dur %d; cd %d", "umbral %d; bloques %d; dur %d; cd %d", "tformat")
t("Rune: Prismatic", "Runa: Prismatic", "talent name")
t("Activate the rune to create a shield for %d turns blocking several instances of damage of the following types:%s", "Activar la runa para crear un escudo para %d se bloquean varias instancias de daño de los siguientes tipos:%s", "tformat")
t("%d turns; %s", "%d vueltas; %s", "tformat")
t("Rune: Mirror Image", "Rune: Imagen del espejo", "talent name")
t("You cannot summon; you are suppressed!", "¡No puedes invocar; estás reprimido!", "logPlayer")
t("Mirror Image", "Imagen del espejo", "_t")
t("A blurred image.", "Una imagen borrosa.", "_t")
t("Summon", "Invocar", "_t")
t("dur %d; cd %d", "dur %d; cd %d", "tformat")
t("Rune: Shatter Afflictions", "Rune: Aflicciones rotatorias", "talent name")
t("absorb %d; cd %d", "%d; cd %d", "tformat")
t("Rune: Dissipation", "Rune: Disipation", "talent name")
t("Activate the rune to remove 8 beneficial magical sustains from an enemy target or all magical debuffs from you.", "Activar la runa para eliminar 8 sostenimientos mágicos beneficiosos de un objetivo enemigo o todos los engaños mágicos de ti.", "tformat")
t(" ", " ", "tformat")
t("Taint: Devourer", "Pintura: Devourer", "talent name")
t("Activate the taint on a foe, removing up to %d magical or physical effects or sustains from it and healing you for %d for each effect.", "Activar la pintura sobre un enemigo, eliminando hasta %d efectos mágicos o físicos o sostiene de él y sanando para %d para cada efecto.", "tformat")
