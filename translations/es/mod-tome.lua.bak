-- section "mod-tome/data/lore/iron-throne.lua"

-- new text
t("iron throne", "trono de hierro", "newLore category")
t("Iron Throne Profits History: Age of Allure", "Iron Throne Profits History: Age of Allure", "_t")
t("Iron Throne Profits History: Age of Dusk", "Iron Throne Profits History: Age of Dusk", "_t")
t("Iron Throne Profits History: Age of Pyre", "Iron Throne Profits History: Age of Pyre", "_t")
t("Iron Throne Profits History: Age of Ascendancy", "Iron Throne Profits History: Age of Ascendancy", "_t")
t("Iron Throne Edict", "Edicto del Trono de Hierro", "_t")
t("Iron Throne trade ledger", "Iron Throne trade ledger", "_t")
t("Iron Throne Reknor expedition, last words", "Expedición de Iron Throne Reknor, últimas palabras", "_t")
t("...We are lost. The orcish forces are too great. No matter how many our squad slays, yet more surge from the depths. Where are the cursed creatures coming from?! We have spied their leader, but have had no hope in killing him; he is a beast, a destroyer, burning with fire infernal and ice cruel and chilling. The power these orcs wield now fills me with dread... perhaps they have found new, mighty allies? This news must reach our ruler. My comrades... I am sorry. I will flee once the opportunity arises, but know that your sacrifices will not be in vain. Long may our empire endure.", "Estamos perdidos. Las fuerzas orcas son demasiado grandes. No importa cuántos de nuestros escuadrones, pero más surgen de las profundidades. ¿De dónde vienen las malditas criaturas? Hemos espiado a tu líder, pero no hemos tenido esperanza en matarlo; él eres una bestia, un destructor, quemando con fuego infernal y hielo cruel y frío. El poder de estos orcos ahora me llena de miedo... ¿quizás han encontrado nuevos y poderosos aliados? Esta noticia debe llegar a nuestro gobernante. Mis camaradas... lo siento. Huiré una vez que surja la oportunidad, pero sé que tus sacrificios no serán en vano. Que nuestro imperio perdure.", "_t")
t("Deep Bellow excavation report 1", "Informe de excavación Hondo Rugido 1", "_t")
t("Deep Bellow excavation report 2", "Informe de excavación Hondo Rugido 2", "_t")
t("Deep Bellow excavation report 3", "Informe de excavación Hondo Rugido 3", "_t")

