t("@Source@ breathes lightning!", "@Source@ respira rayos!", "_t")
t("Lightning Spit", "Relámpago Spit", "talent name")
t("@Source@ spits lightning!", "@Source@ spits rayo!", "_t")
t("Poison Breath", "Veneno Aliento", "talent name")
t("@Source@ breathes poison!", "@Source@ respira veneno!", "_t")
t("Poison Spit", "Veneno Escupir", "talent name")
t("@Source@ spits poison!", "@Source@ spits veneno!", "_t")
t("Winter's Fury", "Winter's Furia", "talent name")
t("Winter's Grasp", "Grasp de invierno", "talent name")
t("Ritch Flamespitter", "Ritch Flamespitter", "talent name")
