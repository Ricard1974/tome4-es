-- section "mod-tome/data/talents/cursed/cursed.lua"

-- new text
t("cursed", "maldito", "talent category")
t("slaughter", "matanza", "talent type")
t("Your weapon yearns for its next victim.", "Tu arma anhela por tu próxima víctima.", "_t")
t("endless hunt", "caza interminable", "talent type")
t("Each day, you lift your weary body and begin the unending hunt.", "Cada día, levantas tu cuerpo cansado y comienzas la caza interminable.", "_t")
t("strife", "conflicto", "talent type")
t("The battlefield is your home; death and confusion, your comfort.", "El campo de batalla es tu hogar; la muerte y la confusión, tu comodidad.", "_t")
t("gloom", "oscuridad", "talent type")
t("All those in your sight must share your despair.", "Todos los que están a tu vista deben compartir tu desesperación.", "_t")
t("rampage", "rampa", "talent type")
t("Let loose the hate that has grown within.", "Deja que el odio que ha crecido dentro.", "_t")
t("predator", "depredador", "talent type")
t("Track and kill your prey with single-minded focus.", "Rastrea y mata a tu presa con enfoque único.", "_t")
t("dark sustenance", "sostenimiento oscuro", "talent type")
t("The powers of your foes feed your dark will.", "Los poderes de tus enemigos alimentan tu oscura voluntad.", "_t")
t("force of will", "fuerza de voluntad", "talent type")
t("Invoke the powerful force of your will.", "Invoca la fuerza poderosa de tu voluntad.", "_t")
t("darkness", "oscuridad", "talent type")
t("Harness the power of darkness to envelop your foes.", "Aprovecha el poder de la oscuridad para envolver a tus enemigos.", "_t")
t("shadows", "sombras", "talent type")
t("Summon shadows from the darkness to aid you.", "Invoca sombras de la oscuridad para ayudarte.", "_t")
t("punishments", "castigos", "talent type")
t("Your hate becomes punishment in the minds of your foes.", "Tu odio se convierte en castigo en la mente de tus enemigos.", "_t")
t("one with shadows", "uno con sombras", "talent type")
t("Harness your shadows to their full potential.", "Saque sus sombras a tu potencial completo.", "_t")
t("advanced shadowmancy", "avanzada sombra", "talent type")
t("Gain more direct control over your shadows with physical damage talents.", "Obtenga un control más directo sobre sus sombras con talentos de daño físico.", "_t")
t("gestures", "gestos", "talent type")
t("Enhance the power of your mind with gestures.", "Mejora el poder de tu mente con gestos.", "_t")
t("cursed form", "forma maldita", "talent type")
t("You are wracked with the dark energies of the curse.", "Estás destrozado con las energías oscuras de la maldición.", "_t")
t("cursed aura", "maldito aura", "talent type")
t("The things you surround yourself with soon wither away.", "Las cosas que te rodean pronto se marchitan.", "_t")
t("curses", "maldiciones", "talent type")
t("The effects of cursed objects.", "Los efectos de objetos malditos.", "_t")
t("fears", "temores", "talent type")
t("Use the fear that lies at the heart of your curse to attack the minds of your enemies.", "Usa el miedo que se encuentra en el corazón de tu maldición para atacar las mentes de tus enemigos.", "_t")
t("Bloodstained", "Sangre manchada", "talent type")
t("You, like your weapons, are tainted forever.", "Tú, como tus armas, estás manchada para siempre.", "_t")
t("Crimson Templar", "Crimson Templar", "talent type")
t("Blood is power. Let the rivers run red.", "La sangre es poder. Que los ríos corran rojos.", "_t")
t("Hatred", "Hatred", "talent type")
t("All the things in this dark world are contemptible.  Let yourself hate them and find the power therein.", "Todas las cosas en este mundo oscuro son despreciables. Déjate odiarlos y encuentra el poder en él.", "_t")
t("Cursed", "Maldito", "talent type")
t("Hate-powered abilities that don't belong anywhere else.", "Hate-powered abilities que no pertenecen a ningún otro lugar.", "_t")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/dark-figure.lua"

-- new text
t("Radiant Fear", "Miedo radiante", "talent name")
t("You are too far to from the target!", "¡Estás demasiado lejos del objetivo!", "logPlayer")
t("Fear radiates from your target in a radius of %d for %d turns driving all others away.", "El miedo irradia de tu objetivo en un radio de %d para %d vuelve a conducir a todos los demás.", "tformat")
t("Suppression", "Represión", "talent name")
t("The time you have spent suppressing the curse has taught you self control. The duration of most non-magical effects are reduced by %d%%.", "El tiempo que has pasado suprimiendo la maldición te ha enseñado el autocontrol. La duración de la mayoría de los efectos no mágicos se reduce en %d%%.", "tformat")
t("Cruel Vigor", "Vigor cruel", "talent name")
t("You are invigorated by the death around you. Each life you take grants %d%% speed for %d more turns.", "Estás vigorizado por la muerte que te rodea. Cada vida que tomas subvenciones %d %% de velocidad para %d más turnos.", "tformat")
t("Pity", "Pity", "talent name")
t("You hide your terrible nature behind a pitiful figure. Those that see you from a distance of %d will ignore you. If you attack or use a talent they will see you for what you are and pity will be deactivated.", "Tú escondes tu terrible naturaleza detrás de una figura piadosa. Aquellos que te vean desde una distancia de %d te ignorarán. Si atacas o usas un talento te verán por lo que eres y la compasión será desactivada.", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/dark-sustenance.lua"

-- new text
t("Feed", "Alimentar", "talent name")
t("You can only gain sustenance from your foes!", "¡Sólo puedes ganar sustento de tus enemigos!", "logPlayer")
t("Devour Life", "Devour Vida", "talent name")
t("Feed Power", "Alimentar Poder", "talent name")
t("Feed Strengths", "Alimentar Strengths", "talent name")
t("Feed from the essence of your enemy. Draws %0.1f hate per turn from a targeted foe, as long as they remain in your line of sight.\n\t\t\tIf you aren't already feeding this will be automatically applied to the nearest enemy.\n\t\tHate gain improves with your Mindpower.", "Alimenta de la esencia de tu enemigo. Dibuja %0.1f odio por turno de un enemigo objetivo, siempre y cuando permanezcan en tu línea de visión.\nSi ya no estás alimentando esto se aplicará automáticamente al enemigo más cercano.\nGanancia de odio mejora con tu poder mental.", "tformat")
t("Devours life from the target of your feeding reducing their life regeneration by %d and adding half of that to yours.\n\t\tImproves with your Mindpower.", "Devours life from the target of your food reducing their life regeneration by %d and adding half of that to yours.\nMejora con tu poder mental.", "tformat")
t("Enhances your feeding by reducing your targeted foe's damage by %d%%, and increasing yours by the same amount.\n\t\tImproves with your Mindpower.", "Mejora tu alimentación reduciendo el daño de tu enemigo objetivo por %d %%, y aumentando el tuyo por la misma cantidad.\nMejora con tu poder mental.", "tformat")
t("Feed from the essence of your enemy. Draws %0.1f hate per turn from a targeted foe, as long as they remain in your line of sight.\n\t\t\tIf you aren't already feeding this will be automatically applied to the nearest enemy.\n\t\tHate gain improves with your Mindpower.", "Alimenta de la esencia de tu enemigo. Dibuja %0.1f odio por turno de un enemigo objetivo, siempre y cuando permanezcan en tu línea de visión.\nSi ya no estás alimentando esto se aplicará automáticamente al enemigo más cercano.\nGanancia de odio mejora con tu poder mental.", "tformat")
t("Devours life from the target of your feeding reducing their life regeneration by %d and adding half of that to yours.\n\t\tImproves with your Mindpower.", "Devours life from the target of your food reducing their life regeneration by %d and adding half of that to yours.\nMejora con tu poder mental.", "tformat")
t("Enhances your feeding by reducing your targeted foe's damage by %d%%, and increasing yours by the same amount.\n\t\tImproves with your Mindpower.", "Mejora tu alimentación reduciendo el daño de tu enemigo objetivo por %d %%, y aumentando el tuyo por la misma cantidad.\nMejora con tu poder mental.", "tformat")
t("Feed from the essence of your enemy. Draws %0.1f hate per turn from a targeted foe, as long as they remain in your line of sight.\n\t\t\tIf you aren't already feeding this will be automatically applied to the nearest enemy.\n\t\tHate gain improves with your Mindpower.", "Alimenta de la esencia de tu enemigo. Dibuja %0.1f odio por turno de un enemigo objetivo, siempre y cuando permanezcan en tu línea de visión.\nSi ya no estás alimentando esto se aplicará automáticamente al enemigo más cercano.\nGanancia de odio mejora con tu poder mental.", "tformat")
t("Devours life from the target of your feeding reducing their life regeneration by %d and adding half of that to yours.\n\t\tImproves with your Mindpower.", "Devours life from the target of your food reducing their life regeneration by %d and adding half of that to yours.\nMejora con tu poder mental.", "tformat")
t("Enhances your feeding by reducing your targeted foe's damage by %d%%, and increasing yours by the same amount.\n\t\tImproves with your Mindpower.", "Mejora tu alimentación reduciendo el daño de tu enemigo objetivo por %d %%, y aumentando el tuyo por la misma cantidad.\nMejora con tu poder mental.", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/darkness.lua"

-- new text
t("dark tendril", "tentil oscuro", "_t")
t("The dark tendrils dissipate.", "Los zarcillos oscuros se disipan.", "logSeen")
t("The dark tendrils lash at %s.", "Los zarcillos oscuros se lanzan a %s.", "logSeen")
t("Creeping Darkness", "Creeping Oscuridad", "talent name")
t("%s's creeping dark", "%s estás oscuro", "tformat")
t("Dark Vision", "Oscuro Vision", "talent name")
t("Dark Torrent", "Oscuro Torrent", "talent name")
t("Dark Tendrils", "Oscuro Tendrils", "talent name")
t("Creeping dark slowly spreads from the target location and %d spots in a radius of %d around the targeted location. The dark deals %0.2f darkness damage each turn to anything in its area, and blocks the sight of any who do not possess Dark Vision or some other magical means of seeing. The darkness seeps into adjacent tiles at random and slowly dissipates over time.\n\t\tThe damage will increase with your Mindpower. You do +%d%% damage to anything that has entered your creeping dark.", "Creeping dark slow spreads from the target location and %d spots in a radius of %d around the targeted location. Las oscuras ofertas %0.2f oscuridad daña cada vuelta a cualquier cosa en tu área, y bloquea la vista de cualquiera que no posea Visión Oscura o algún otro medio mágico de ver. La oscuridad entra en las baldosas adyacentes al azar y se disipa lentamente con el tiempo.\nEl daño aumentará con tu poder mental. Tú hace +%d %% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Your eyes penetrate the darkness to find anyone that may be hiding there. This allows you to see through creeping darkness out to a radius of %d. You can also find your way through the darkness with greater speed (+%d%% movement into creeping darkness).\n\t\tYou do +%d%% damage to anything that has entered your creeping dark.", "Tus ojos penetran en la oscuridad para encontrar a alguien que pueda estar escondido allí. Esto te permite ver a través de la oscuridad arrastrando hacia un radio de %d. Tú también puedes encontrar tu camino a través de la oscuridad con mayor velocidad (+%d %% movimiento en la oscuridad escalofriante).\nUsted hace +%d %% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Sends a torrent of searing darkness through your foes, doing %d darkness damage. There is a 25%% chance the rushing darkness will blind them for 3 turns and cause them to lose track of their target.\n\t\tIf you know the Creeping Darkness talent, a short-lived trail of darkness is left in the beam's wake. Its damage is identical to that of Creeping Darkness's.\n\t\tThe damage will increase with your Mindpower. You do +%d%% damage to anything that has entered your creeping dark.", "Envía un torrente de oscuridad a través de tus enemigos, haciendo daño de las tinieblas. Hay un 25% de probabilidades de que la oscuridad apresurada los cegue por 3 vueltas y los haga perder el rastro de tu objetivo. \n\t\t Si conoces el talento de la Oscuridad Creeping, un sendero de poca vida de oscuridad queda en el velatorio. Tu daño es idéntico al de Creeping Darkness. El daño aumentará con tu poder mental. Tú hace +§%d §% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Spawn tendrils of darkness to pursue a single target for up to 12 turns, leaving behind a trail of creeping darkness as they move. Targets seized by the tendrils are pinned for %d turns and shrouded in darkness. The darkness deals %0.2f damage per turn to those within.\n\t\tThe damage will increase with your Mindpower. You do +%d%% damage to anything that has entered your creeping dark.", "Tijeras de oscuridad para perseguir un solo objetivo por hasta 12 vueltas, dejando atrás un rastro de oscuridad que se mueve. Los objetivos incautados por los zarcillos están marcados por los turnos del %d y envueltos en oscuridad. La oscuridad trata %0.2f daño a turno a aquellos dentro. El daño aumentará con tu poder mental. Tú hace +§%d §% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Creeping dark slowly spreads from the target location and %d spots in a radius of %d around the targeted location. The dark deals %0.2f darkness damage each turn to anything in its area, and blocks the sight of any who do not possess Dark Vision or some other magical means of seeing. The darkness seeps into adjacent tiles at random and slowly dissipates over time.\n\t\tThe damage will increase with your Mindpower. You do +%d%% damage to anything that has entered your creeping dark.", "Creeping dark slow spreads from the target location and %d spots in a radius of %d around the targeted location. Las oscuras ofertas %0.2f oscuridad daña cada vuelta a cualquier cosa en tu área, y bloquea la vista de cualquiera que no posea Visión Oscura o algún otro medio mágico de ver. La oscuridad entra en las baldosas adyacentes al azar y se disipa lentamente con el tiempo.\nEl daño aumentará con tu poder mental. Tú hace +%d %% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Your eyes penetrate the darkness to find anyone that may be hiding there. This allows you to see through creeping darkness out to a radius of %d. You can also find your way through the darkness with greater speed (+%d%% movement into creeping darkness).\n\t\tYou do +%d%% damage to anything that has entered your creeping dark.", "Tus ojos penetran en la oscuridad para encontrar a alguien que pueda estar escondido allí. Esto te permite ver a través de la oscuridad arrastrando hacia un radio de %d. Tú también puedes encontrar tu camino a través de la oscuridad con mayor velocidad (+%d %% movimiento en la oscuridad escalofriante).\nUsted hace +%d %% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Sends a torrent of searing darkness through your foes, doing %d darkness damage. There is a 25%% chance the rushing darkness will blind them for 3 turns and cause them to lose track of their target.\n\t\tIf you know the Creeping Darkness talent, a short-lived trail of darkness is left in the beam's wake. Its damage is identical to that of Creeping Darkness's.\n\t\tThe damage will increase with your Mindpower. You do +%d%% damage to anything that has entered your creeping dark.", "Envía un torrente de oscuridad a través de tus enemigos, haciendo daño de las tinieblas. Hay un 25% de probabilidades de que la oscuridad apresurada los cegue por 3 vueltas y los haga perder el rastro de tu objetivo. \n\t\t Si conoces el talento de la Oscuridad Creeping, un sendero de poca vida de oscuridad queda en el velatorio. Tu daño es idéntico al de Creeping Darkness. El daño aumentará con tu poder mental. Tú hace +§%d §% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Spawn tendrils of darkness to pursue a single target for up to 12 turns, leaving behind a trail of creeping darkness as they move. Targets seized by the tendrils are pinned for %d turns and shrouded in darkness. The darkness deals %0.2f damage per turn to those within.\n\t\tThe damage will increase with your Mindpower. You do +%d%% damage to anything that has entered your creeping dark.", "Tijeras de oscuridad para perseguir un solo objetivo por hasta 12 vueltas, dejando atrás un rastro de oscuridad que se mueve. Los objetivos incautados por los zarcillos están marcados por los turnos del %d y envueltos en oscuridad. La oscuridad trata %0.2f daño a turno a aquellos dentro. El daño aumentará con tu poder mental. Tú hace +§%d §% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Creeping dark slowly spreads from the target location and %d spots in a radius of %d around the targeted location. The dark deals %0.2f darkness damage each turn to anything in its area, and blocks the sight of any who do not possess Dark Vision or some other magical means of seeing. The darkness seeps into adjacent tiles at random and slowly dissipates over time.\n\t\tThe damage will increase with your Mindpower. You do +%d%% damage to anything that has entered your creeping dark.", "Creeping dark slow spreads from the target location and %d spots in a radius of %d around the targeted location. Las oscuras ofertas %0.2f oscuridad daña cada vuelta a cualquier cosa en tu área, y bloquea la vista de cualquiera que no posea Visión Oscura o algún otro medio mágico de ver. La oscuridad entra en las baldosas adyacentes al azar y se disipa lentamente con el tiempo.\nEl daño aumentará con tu poder mental. Tú hace +%d %% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Your eyes penetrate the darkness to find anyone that may be hiding there. This allows you to see through creeping darkness out to a radius of %d. You can also find your way through the darkness with greater speed (+%d%% movement into creeping darkness).\n\t\tYou do +%d%% damage to anything that has entered your creeping dark.", "Tus ojos penetran en la oscuridad para encontrar a alguien que pueda estar escondido allí. Esto te permite ver a través de la oscuridad arrastrando hacia un radio de %d. Tú también puedes encontrar tu camino a través de la oscuridad con mayor velocidad (+%d %% movimiento en la oscuridad escalofriante).\nUsted hace +%d %% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Sends a torrent of searing darkness through your foes, doing %d darkness damage. There is a 25%% chance the rushing darkness will blind them for 3 turns and cause them to lose track of their target.\n\t\tIf you know the Creeping Darkness talent, a short-lived trail of darkness is left in the beam's wake. Its damage is identical to that of Creeping Darkness's.\n\t\tThe damage will increase with your Mindpower. You do +%d%% damage to anything that has entered your creeping dark.", "Envía un torrente de oscuridad a través de tus enemigos, haciendo daño de las tinieblas. Hay un 25% de probabilidades de que la oscuridad apresurada los cegue por 3 vueltas y los haga perder el rastro de tu objetivo. \n\t\t Si conoces el talento de la Oscuridad Creeping, un sendero de poca vida de oscuridad queda en el velatorio. Tu daño es idéntico al de Creeping Darkness. El daño aumentará con tu poder mental. Tú hace +§%d §% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")
t("Spawn tendrils of darkness to pursue a single target for up to 12 turns, leaving behind a trail of creeping darkness as they move. Targets seized by the tendrils are pinned for %d turns and shrouded in darkness. The darkness deals %0.2f damage per turn to those within.\n\t\tThe damage will increase with your Mindpower. You do +%d%% damage to anything that has entered your creeping dark.", "Tijeras de oscuridad para perseguir un solo objetivo por hasta 12 vueltas, dejando atrás un rastro de oscuridad que se mueve. Los objetivos incautados por los zarcillos están marcados por los turnos del %d y envueltos en oscuridad. La oscuridad trata %0.2f daño a turno a aquellos dentro. El daño aumentará con tu poder mental. Tú hace +§%d §% daño a cualquier cosa que ha entrado en tu oscuro repugnante.", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/endless-hunt.lua"

-- new text
t("Stalk", "Acechar", "talent name")
t("#F53CBE#You are having trouble focusing on your prey!", "¡Tienes problemas para concentrarte en tu presa!", "logPlayer")
t("Harass Prey", "Harass Presión", "talent name")
t("#F53CBE#%s's %s is disrupted!", "#F53CBE# %s 's %s es interrumpido!", "logSeen")
t("Beckon", "Llamar", "talent name")
t("Surge", "o", "talent name")
t("When you focus your attacks on a single foe and strike them in melee for two consecutive turns, your hatred of them overcomes you and you begin to stalk them with single-minded purpose. The effect will last for %d turns, or until your prey is dead. Stalking gives you bonuses against your foe that grow each turn you hit them, and diminish each turn you don't.\n\t\tBonus level 1: +%d Accuracy, +%d%% melee damage, +%0.2f hate/turn prey was hit\n\t\tBonus level 2: +%d Accuracy, +%d%% melee damage, +%0.2f hate/turn prey was hit\n\t\tBonus level 3: +%d Accuracy, +%d%% melee damage, +%0.2f hate/turn prey was hit\n\t\tThe accuracy bonus improves with your Willpower, and the melee damage bonus with your Strength.", "Cuando centras tus ataques en un solo enemigo y los golpeas en la cuerpo a cuerpo por dos vueltas consecutivas, tu odio de ellos te supera y comienzas a acecharlos con un solo propósito. El efecto durará por turnos %d, o hasta que tu presa esté muerta. Stalking te da bonos contra tu enemigo que crecen cada vuelta que los golpeas, y disminuir cada vuelta que no lo haces.\n\t\tBonus nivel 1: +%d Precisión, +§%d §% daño cuerpo a cuerpo, +%0.2f odio / vuelta presa fue golpeado\n\t\tBonus nivel 2: +%d Precisión, +§%d §% cuerpo a cuerpo damage, +§%0.2f hate§/turn prey was hit\n\t\tBonus level 3: +%d Precisión, +§%d §% cuerpo a cuerpo damage, +§%0.2f hate§/turn prey was hit\n\t\t El bono de precisión mejora con tu fuerza de voluntad, y el cuerpo a cuerpo bono de daño con tu fuerza.", "tformat")
t("Harass your stalked victim with two quick attacks for %d%% (at 0 Hate) to %d%% (at 100+ Hate) damage each. Each attack that scores a hit disrupts one talent, rune or infusion for %d turns. Your opponent will be unnerved by the attacks, reducing the damage they deal by %d%% for %d turns.\n\n\t\tThis talent will also attack with your shield, if you have one equipped.", "Acosar a tu víctima acosada con dos ataques rápidos para %d %% (a 0 odio) a %d %% (a 100+ Odio) daño cada uno. Cada ataque que marca un golpe interrumpe un talento, runa o infusión para turnos de %d. Tu oponente no será alterado por los ataques, reduciendo el daño que tratan por %d %% para turnos de %d.\n\nEste talento también atacará con tu escudo, si tienes uno equipado.", "tformat")
t("The connection between predator and prey allows you to speak to the mind of your target and beckon them closer. For %d turns, they will try to come to you, even pushing others aside to do so. They will move towards you instead of acting %d%% of the time, but can save verses Mindpower to slow the effect. If they take significant damage, the beckoning may be overcome altogether. The effect makes concentration difficult for your target, reducing Spellpower and Mindpower by %d until they reach you.\n\t\tThe Spellpower and Mindpower reduction increases with your Willpower.", "La conexión entre el depredador y la presa le permite hablar con la mente de tu objetivo y acercarlos. Por turnos de %d, intentarán venir a ti, incluso empujando a otros a un lado para hacerlo. Se moverán hacia ti en lugar de actuar %d %% del tiempo, pero puedes salvar versículos Poder mental para frenar el efecto. Si se toman daños significativos, se puede superar la banca por completo. El efecto haces que la concentración sea difícil para tu objetivo, reduciendo Spellpower y Mindpower por %d hasta que lleguen a tú.\nLa reducción de potencia y fuerza mental aumentas con tu fuerza de voluntad.", "tformat")
t("Let hate fuel your movements. While active, you gain %d%% movement speed. The recklessness of your movement brings you bad luck (Luck -3).\n\t\tCleave, Repel and Surge cannot be active simultaneously, and activating one will place the others in cooldown.\n\t\tSustaining Surge while Dual Wielding grants %d additional Defense.\n\t\tMovement speed and dual-wielding Defense both increase with the Willpower stat.", "Deja que el odio alimente tus movimientos. Mientras estás activo, tú ganas la velocidad del movimiento %d %%. La imprudencia de tu movimiento te trae mala suerte (Luck -3).\nCleave, Repel y Surge no pueden ser activos simultáneamente, y activar uno colocará a los otros en en enfriamiento.\nSostenimiento de Surge mientras Dual Wielding otorga %d Defensa adicional.\nLa velocidad de movimiento y la defensa dual aumentan con el puesto de Willpower.", "tformat")
t("When you focus your attacks on a single foe and strike them in melee for two consecutive turns, your hatred of them overcomes you and you begin to stalk them with single-minded purpose. The effect will last for %d turns, or until your prey is dead. Stalking gives you bonuses against your foe that grow each turn you hit them, and diminish each turn you don't.\n\t\tBonus level 1: +%d Accuracy, +%d%% melee damage, +%0.2f hate/turn prey was hit\n\t\tBonus level 2: +%d Accuracy, +%d%% melee damage, +%0.2f hate/turn prey was hit\n\t\tBonus level 3: +%d Accuracy, +%d%% melee damage, +%0.2f hate/turn prey was hit\n\t\tThe accuracy bonus improves with your Willpower, and the melee damage bonus with your Strength.", "Cuando centras tus ataques en un solo enemigo y los golpeas en la cuerpo a cuerpo por dos vueltas consecutivas, tu odio de ellos te supera y comienzas a acecharlos con un solo propósito. El efecto durará por turnos %d, o hasta que tu presa esté muerta. Stalking te da bonos contra tu enemigo que crecen cada vuelta que los golpeas, y disminuir cada vuelta que no lo haces.\n\t\tBonus nivel 1: +%d Precisión, +§%d §% daño cuerpo a cuerpo, +%0.2f odio / vuelta presa fue golpeado\n\t\tBonus nivel 2: +%d Precisión, +§%d §% cuerpo a cuerpo damage, +§%0.2f hate§/turn prey was hit\n\t\tBonus level 3: +%d Precisión, +§%d §% cuerpo a cuerpo damage, +§%0.2f hate§/turn prey was hit\n\t\t El bono de precisión mejora con tu fuerza de voluntad, y el cuerpo a cuerpo bono de daño con tu fuerza.", "tformat")
t("Harass your stalked victim with two quick attacks for %d%% (at 0 Hate) to %d%% (at 100+ Hate) damage each. Each attack that scores a hit disrupts one talent, rune or infusion for %d turns. Your opponent will be unnerved by the attacks, reducing the damage they deal by %d%% for %d turns.\n\n\t\tThis talent will also attack with your shield, if you have one equipped.", "Acosar a tu víctima acosada con dos ataques rápidos para %d %% (a 0 odio) a %d %% (a 100+ Odio) daño cada uno. Cada ataque que marca un golpe interrumpe un talento, runa o infusión para turnos de %d. Tu oponente no será alterado por los ataques, reduciendo el daño que tratan por %d %% para turnos de %d.\n\nEste talento también atacará con tu escudo, si tienes uno equipado.", "tformat")
t("The connection between predator and prey allows you to speak to the mind of your target and beckon them closer. For %d turns, they will try to come to you, even pushing others aside to do so. They will move towards you instead of acting %d%% of the time, but can save verses Mindpower to slow the effect. If they take significant damage, the beckoning may be overcome altogether. The effect makes concentration difficult for your target, reducing Spellpower and Mindpower by %d until they reach you.\n\t\tThe Spellpower and Mindpower reduction increases with your Willpower.", "La conexión entre el depredador y la presa le permite hablar con la mente de tu objetivo y acercarlos. Por turnos de %d, intentarán venir a ti, incluso empujando a otros a un lado para hacerlo. Se moverán hacia ti en lugar de actuar %d %% del tiempo, pero puedes salvar versículos Poder mental para frenar el efecto. Si se toman daños significativos, se puede superar la banca por completo. El efecto haces que la concentración sea difícil para tu objetivo, reduciendo Spellpower y Mindpower por %d hasta que lleguen a tú.\nLa reducción de potencia y fuerza mental aumentas con tu fuerza de voluntad.", "tformat")
t("Let hate fuel your movements. While active, you gain %d%% movement speed. The recklessness of your movement brings you bad luck (Luck -3).\n\t\tCleave, Repel and Surge cannot be active simultaneously, and activating one will place the others in cooldown.\n\t\tSustaining Surge while Dual Wielding grants %d additional Defense.\n\t\tMovement speed and dual-wielding Defense both increase with the Willpower stat.", "Deja que el odio alimente tus movimientos. Mientras estás activo, tú ganas la velocidad del movimiento %d %%. La imprudencia de tu movimiento te trae mala suerte (Luck -3).\nCleave, Repel y Surge no pueden ser activos simultáneamente, y activar uno colocará a los otros en en enfriamiento.\nSostenimiento de Surge mientras Dual Wielding otorga %d Defensa adicional.\nLa velocidad de movimiento y la defensa dual aumentan con el puesto de Willpower.", "tformat")
t("When you focus your attacks on a single foe and strike them in melee for two consecutive turns, your hatred of them overcomes you and you begin to stalk them with single-minded purpose. The effect will last for %d turns, or until your prey is dead. Stalking gives you bonuses against your foe that grow each turn you hit them, and diminish each turn you don't.\n\t\tBonus level 1: +%d Accuracy, +%d%% melee damage, +%0.2f hate/turn prey was hit\n\t\tBonus level 2: +%d Accuracy, +%d%% melee damage, +%0.2f hate/turn prey was hit\n\t\tBonus level 3: +%d Accuracy, +%d%% melee damage, +%0.2f hate/turn prey was hit\n\t\tThe accuracy bonus improves with your Willpower, and the melee damage bonus with your Strength.", "Cuando centras tus ataques en un solo enemigo y los golpeas en la cuerpo a cuerpo por dos vueltas consecutivas, tu odio de ellos te supera y comienzas a acecharlos con un solo propósito. El efecto durará por turnos %d, o hasta que tu presa esté muerta. Stalking te da bonos contra tu enemigo que crecen cada vuelta que los golpeas, y disminuir cada vuelta que no lo haces.\n\t\tBonus nivel 1: +%d Precisión, +§%d §% daño cuerpo a cuerpo, +%0.2f odio / vuelta presa fue golpeado\n\t\tBonus nivel 2: +%d Precisión, +§%d §% cuerpo a cuerpo damage, +§%0.2f hate§/turn prey was hit\n\t\tBonus level 3: +%d Precisión, +§%d §% cuerpo a cuerpo damage, +§%0.2f hate§/turn prey was hit\n\t\t El bono de precisión mejora con tu fuerza de voluntad, y el cuerpo a cuerpo bono de daño con tu fuerza.", "tformat")
t("Harass your stalked victim with two quick attacks for %d%% (at 0 Hate) to %d%% (at 100+ Hate) damage each. Each attack that scores a hit disrupts one talent, rune or infusion for %d turns. Your opponent will be unnerved by the attacks, reducing the damage they deal by %d%% for %d turns.\n\n\t\tThis talent will also attack with your shield, if you have one equipped.", "Acosar a tu víctima acosada con dos ataques rápidos para %d %% (a 0 odio) a %d %% (a 100+ Odio) daño cada uno. Cada ataque que marca un golpe interrumpe un talento, runa o infusión para turnos de %d. Tu oponente no será alterado por los ataques, reduciendo el daño que tratan por %d %% para turnos de %d.\n\nEste talento también atacará con tu escudo, si tienes uno equipado.", "tformat")
t("The connection between predator and prey allows you to speak to the mind of your target and beckon them closer. For %d turns, they will try to come to you, even pushing others aside to do so. They will move towards you instead of acting %d%% of the time, but can save verses Mindpower to slow the effect. If they take significant damage, the beckoning may be overcome altogether. The effect makes concentration difficult for your target, reducing Spellpower and Mindpower by %d until they reach you.\n\t\tThe Spellpower and Mindpower reduction increases with your Willpower.", "La conexión entre el depredador y la presa le permite hablar con la mente de tu objetivo y acercarlos. Por turnos de %d, intentarán venir a ti, incluso empujando a otros a un lado para hacerlo. Se moverán hacia ti en lugar de actuar %d %% del tiempo, pero puedes salvar versículos Poder mental para frenar el efecto. Si se toman daños significativos, se puede superar la banca por completo. El efecto haces que la concentración sea difícil para tu objetivo, reduciendo Spellpower y Mindpower por %d hasta que lleguen a tú.\nLa reducción de potencia y fuerza mental aumentas con tu fuerza de voluntad.", "tformat")
t("Let hate fuel your movements. While active, you gain %d%% movement speed. The recklessness of your movement brings you bad luck (Luck -3).\n\t\tCleave, Repel and Surge cannot be active simultaneously, and activating one will place the others in cooldown.\n\t\tSustaining Surge while Dual Wielding grants %d additional Defense.\n\t\tMovement speed and dual-wielding Defense both increase with the Willpower stat.", "Deja que el odio alimente tus movimientos. Mientras estás activo, tú ganas la velocidad del movimiento %d %%. La imprudencia de tu movimiento te trae mala suerte (Luck -3).\nCleave, Repel y Surge no pueden ser activos simultáneamente, y activar uno colocará a los otros en en enfriamiento.\nSostenimiento de Surge mientras Dual Wielding otorga %d Defensa adicional.\nLa velocidad de movimiento y la defensa dual aumentan con el puesto de Willpower.", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/fears.lua"

-- new text
t("Instill Fear", "Inculcar miedo", "talent name")
t("%s resists the fear!", "%s resiste el miedo!", "logSeen")
t("#F53CBE#%s resists the fear!", "¡F53CBE#%s resiste el miedo!", "logSeen")
t("Heighten Fear", "Miedo de Altura", "talent name")
t("Tyrant", "o", "talent name")
t("Panic", "Pánico", "talent name")
t("#F53CBE#%s ignores the panic!", "#F53CBE# %s ignora el pánico!", "logSeen")
t("#F53CBE#%s resists the panic!", "¡F53CBE#%s resiste el pánico!", "logSeen")
t("Panic your enemies within a range of %d for %d turns. Anyone who fails to make a mental save against your Mindpower has a %d%% chance each turn of trying to run away from you.", "Pásate a tus enemigos dentro de una gama de %d para %d vueltas. Cualquiera que no haga un ahorro mental contra tu poder mental tienes una oportunidad %d %% cada giro de tratar de huir de tú.", "tformat")
t("Instill fear in your foes within %d radius of a target location dealing %0.2f mind and %0.2f darkness damage and causing one of 4 possible fears that last for %d turns.\n\t\tThe targets can save vs your Mindpower to resist the effect.\n\t\tFear effects improve with your Mindpower.\n\n\t\tPossible fears are:\n\t\t#ORANGE#Paranoid:#LAST# Gives the target an %d%% chance to physically attack a nearby creature, friend or foe. If hit, their target will be afflicted with Paranoia as well.\n\t\t#ORANGE#Despair:#LAST# Reduces mind resist, mindsave, armour and defence by %d.\n\t\t#ORANGE#Terrified:#LAST# Deals %0.2f mind and %0.2f darkness damage per turn and increases cooldowns by %d%%.\n\t\t#ORANGE#Haunted:#LAST# Causes the target to suffer %0.2f mind and %0.2f darkness damage for each detrimental mental effect every turn.", "Inculca el miedo en tus enemigos dentro del radio de %d de un lugar objetivo tratando la mente %0.2f y %0.2f daño de la oscuridad y causando uno de los 4 posibles miedos que duran para %d turnos.\nLos objetivos pueden salvar vs tu fuerza mental para resistir el efecto.\nLos efectos del miedo mejoran con tu poder mental.\n\nLos temores posibles son:\n#ORANGE# Paranoid:# Da al objetivo una oportunidad de %d %% para atacar físicamente a una criatura cercana, amigo o enemigo. Si se golpea, tu objetivo será afligido también con Paranoia.\n#ORANGE#Despair:#LAST# Reduce la resistencia mental, el alivio mental, la armadura y la defensa por %d.\n#ORANGE#Terrified:#LAST# Tratos mente %0.2f y %0.2f daño de la oscuridad por turno y aumentas las refrigeraciones por %d %%.\n#ORANGE#Haunted:#LAST# Causa el objetivo de sufrir %0.2f mente y %0.2f daño de la oscuridad por cada efecto mental perjudicial cada vuelta.", "tformat")
t("Impose your tyranny on the minds of those who fear you. When a foe gains a new fear, you have a %d%% chance to increase the duration of their heightened fear and one random existing fear effect by %d turns, to a maximum of 8 turns.\n\t\tAdditionally, you gain %d Mindpower and Physical power for 5 turns every time you apply a fear, stacking up to %d times.", "Pon tu tiranía en la mente de aquellos que te te temen. Cuando un enemigo ganas un nuevo miedo, tú tienes una oportunidad de %d %% para aumentar la duración de tu miedo aumentado y un efecto de miedo existente al azar por turnos %d, a un máximo de 8 vueltas.\nAdemás, tú gana %d Fuerza de la mente y el poder físico por 5 vueltas cada vez que aplicas un miedo, apilando hasta tiempos de %d.", "tformat")
t("Instill fear in your foes within %d radius of a target location dealing %0.2f mind and %0.2f darkness damage and causing one of 4 possible fears that last for %d turns.\n\t\tThe targets can save vs your Mindpower to resist the effect.\n\t\tFear effects improve with your Mindpower.\n\n\t\tPossible fears are:\n\t\t#ORANGE#Paranoid:#LAST# Gives the target an %d%% chance to physically attack a nearby creature, friend or foe. If hit, their target will be afflicted with Paranoia as well.\n\t\t#ORANGE#Despair:#LAST# Reduces mind resist, mindsave, armour and defence by %d.\n\t\t#ORANGE#Terrified:#LAST# Deals %0.2f mind and %0.2f darkness damage per turn and increases cooldowns by %d%%.\n\t\t#ORANGE#Haunted:#LAST# Causes the target to suffer %0.2f mind and %0.2f darkness damage for each detrimental mental effect every turn.", "Inculca el miedo en tus enemigos dentro del radio de %d de un lugar objetivo tratando la mente %0.2f y %0.2f daño de la oscuridad y causando uno de los 4 posibles miedos que duran para %d turnos.\nLos objetivos pueden salvar vs tu fuerza mental para resistir el efecto.\nLos efectos del miedo mejoran con tu poder mental.\n\nLos temores posibles son:\n#ORANGE# Paranoid:# Da al objetivo una oportunidad de %d %% para atacar físicamente a una criatura cercana, amigo o enemigo. Si se golpea, tu objetivo será afligido también con Paranoia.\n#ORANGE#Despair:#LAST# Reduce la resistencia mental, el alivio mental, la armadura y la defensa por %d.\n#ORANGE#Terrified:#LAST# Tratos mente %0.2f y %0.2f daño de la oscuridad por turno y aumentas las refrigeraciones por %d %%.\n#ORANGE#Haunted:#LAST# Causa el objetivo de sufrir %0.2f mente y %0.2f daño de la oscuridad por cada efecto mental perjudicial cada vuelta.", "tformat")
t("Impose your tyranny on the minds of those who fear you. When a foe gains a new fear, you have a %d%% chance to increase the duration of their heightened fear and one random existing fear effect by %d turns, to a maximum of 8 turns.\n\t\tAdditionally, you gain %d Mindpower and Physical power for 5 turns every time you apply a fear, stacking up to %d times.", "Pon tu tiranía en la mente de aquellos que te te temen. Cuando un enemigo ganas un nuevo miedo, tú tienes una oportunidad de %d %% para aumentar la duración de tu miedo aumentado y un efecto de miedo existente al azar por turnos %d, a un máximo de 8 vueltas.\nAdemás, tú gana %d Fuerza de la mente y el poder físico por 5 vueltas cada vez que aplicas un miedo, apilando hasta tiempos de %d.", "tformat")
t("Instill fear in your foes within %d radius of a target location dealing %0.2f mind and %0.2f darkness damage and causing one of 4 possible fears that last for %d turns.\n\t\tThe targets can save vs your Mindpower to resist the effect.\n\t\tFear effects improve with your Mindpower.\n\n\t\tPossible fears are:\n\t\t#ORANGE#Paranoid:#LAST# Gives the target an %d%% chance to physically attack a nearby creature, friend or foe. If hit, their target will be afflicted with Paranoia as well.\n\t\t#ORANGE#Despair:#LAST# Reduces mind resist, mindsave, armour and defence by %d.\n\t\t#ORANGE#Terrified:#LAST# Deals %0.2f mind and %0.2f darkness damage per turn and increases cooldowns by %d%%.\n\t\t#ORANGE#Haunted:#LAST# Causes the target to suffer %0.2f mind and %0.2f darkness damage for each detrimental mental effect every turn.", "Inculca el miedo en tus enemigos dentro del radio de %d de un lugar objetivo tratando la mente %0.2f y %0.2f daño de la oscuridad y causando uno de los 4 posibles miedos que duran para %d turnos.\nLos objetivos pueden salvar vs tu fuerza mental para resistir el efecto.\nLos efectos del miedo mejoran con tu poder mental.\n\nLos temores posibles son:\n#ORANGE# Paranoid:# Da al objetivo una oportunidad de %d %% para atacar físicamente a una criatura cercana, amigo o enemigo. Si se golpea, tu objetivo será afligido también con Paranoia.\n#ORANGE#Despair:#LAST# Reduce la resistencia mental, el alivio mental, la armadura y la defensa por %d.\n#ORANGE#Terrified:#LAST# Tratos mente %0.2f y %0.2f daño de la oscuridad por turno y aumentas las refrigeraciones por %d %%.\n#ORANGE#Haunted:#LAST# Causa el objetivo de sufrir %0.2f mente y %0.2f daño de la oscuridad por cada efecto mental perjudicial cada vuelta.", "tformat")
t("Heighten the fears of those near to you. Any foe you attempt to inflict a fear upon and who remains in a radius of %d and in sight of you for %d (non-consecutive) turns, will take %0.2f mind and %0.2f darkness damage and gain a new fear that lasts for %d turns.\n\t\t\tThis effect completely ignores fear resistance, but can be saved against.", "Alcance los temores de los que están cerca de tú. Cualquier enemigo que intentes infligir un miedo y que permanece en un radio de %d y a la vista de ti por %d (no-consecutivo) turnos, tomará %0.2f mente y %0.2f daño de la oscuridad y ganar un nuevo miedo que dura para %d turnos.\nEste efecto ignora completamente la resistencia al miedo, pero se puede salvar contra.", "tformat")
t("Impose your tyranny on the minds of those who fear you. When a foe gains a new fear, you have a %d%% chance to increase the duration of their heightened fear and one random existing fear effect by %d turns, to a maximum of 8 turns.\n\t\tAdditionally, you gain %d Mindpower and Physical power for 5 turns every time you apply a fear, stacking up to %d times.", "Pon tu tiranía en la mente de aquellos que te te temen. Cuando un enemigo ganas un nuevo miedo, tú tienes una oportunidad de %d %% para aumentar la duración de tu miedo aumentado y un efecto de miedo existente al azar por turnos %d, a un máximo de 8 vueltas.\nAdemás, tú gana %d Fuerza de la mente y el poder físico por 5 vueltas cada vez que aplicas un miedo, apilando hasta tiempos de %d.", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/force-of-will.lua"

-- new text
t("Willful Strike", "Willful Golpe", "talent name")
t("#Source# was blasted %d spaces into #Target#!", "#Source# was blasted %d espacios into #Target#!", "logCombat")
t("#Source# was blasted into #Target#!", "#Source# fue lanzado en #Target#!", "logCombat")
t("%s was smashed back %d spaces!", "%s espacios!%d", "logSeen")
t("%s was smashed!", "%s fue aplastado!", "logSeen")
t("%s was blasted back %d spaces!", "%s espacios!%d", "logSeen")
t("Deflection", "Deflexión", "talent name")
t("Deflection (%d)", "Deflection ( %d )", "tformat")
t("You have deflected %d incoming damage!", "Tú ha desviado %d daño entrante!", "logPlayer")
t("Blast", "Explosion", "talent name")
t("Unseen Force", "Fuerza invisible", "talent name")
t("Focusing your hate, you strike your foe with unseen force for %d damage and %d knockback.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tDamage increases with your Mindpower.", "Centrándote en tu odio, golpeas a tu enemigo con fuerza invisible por daños %d y %d knockback. \n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d% (currently: %d%%)\n\t\t\tDamage increases with your Mindpower.", "tformat")
t("Create a barrier that siphons hate from you at the rate of 0.2 a turn. The barrier will deflect 50%% of incoming damage with the force of your will, up to %d damage. The barrier charges at a rate of 1/%d of its maximum charge per turn.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tThe maximum damage deflected increases with your Mindpower.", "Cree una barrera que los sifones odian de tú a la velocidad de 0,2 a giro. La barrera desviará 50%% de daño entrantes con la fuerza de tu voluntad, hasta daño de %d. La barrera carga a una tasa de 1/%d de tu carga máxima por turno.\nAdemás, tu capacidad para canalizar la fuerza con este talento aumentas todo daño crítico por %d %% (actualmente: %d %%)\nEl daño máximo desviado aumentas con tu poder mental.", "tformat")
t("You rage coalesces at a single point, and then explodes outward, blasting enemies within a radius of %d in all directions. The blast causes %d damage and %d knockback at the center, that decreases with distance. Anyone caught in the explosion will also be dazed for 3 turns.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tDamage increases with your Mindpower.", "Tú rabia coalesces en un solo punto, y luego explota hacia fuera, despertando enemigos dentro de un radio de %d en todas direcciones. La explosión causa daño a %d y %d en el centro, que disminuye con la distancia. Cualquiera atrapado en la explosión también será aturdido por 3 vueltas.\nAdemás, tu capacidad para canalizar la fuerza con este talento aumentas todo daño crítico por %d %% (actualmente: %d %%)\nEl daño aumentas con tu poder mental.", "tformat")
t("Your fury becomes an unseen force that randomly lashes out at foes around you. For %d turns you strike %d (%d%% chance for %d) nearby target(s) within range %d doing %d damage and %d knockback. The number of extra strikes increases at higher talent levels.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tDamage increases with your Mindpower.", "Tu furia se convierte en una fuerza invisible que aleatoriamente echa a los enemigos a tu alrededor. Para %d se convierte en %d (%d %% posibilidad de %d) objetivo cercano(s) dentro del rango %d haciendo daño %d y %d knockback. El número de huelgas adicionales aumentas a niveles más altos de talento.\nAdemás, tu capacidad para canalizar la fuerza con este talento aumentas todo daño crítico por %d %% (actualmente: %d %%)\nEl daño aumentas con tu poder mental.", "tformat")
t("Focusing your hate, you strike your foe with unseen force for %d damage and %d knockback.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tDamage increases with your Mindpower.", "Centrándote en tu odio, golpeas a tu enemigo con fuerza invisible por daños %d y %d knockback. \n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d% (currently: %d%%)\n\t\t\tDamage increases with your Mindpower.", "tformat")
t("Create a barrier that siphons hate from you at the rate of 0.2 a turn. The barrier will deflect 50%% of incoming damage with the force of your will, up to %d damage. The barrier charges at a rate of 1/%d of its maximum charge per turn.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tThe maximum damage deflected increases with your Mindpower.", "Cree una barrera que los sifones odian de tú a la velocidad de 0,2 a giro. La barrera desviará 50%% de daño entrantes con la fuerza de tu voluntad, hasta daño de %d. La barrera carga a una tasa de 1/%d de tu carga máxima por turno.\nAdemás, tu capacidad para canalizar la fuerza con este talento aumentas todo daño crítico por %d %% (actualmente: %d %%)\nEl daño máximo desviado aumentas con tu poder mental.", "tformat")
t("You rage coalesces at a single point, and then explodes outward, blasting enemies within a radius of %d in all directions. The blast causes %d damage and %d knockback at the center, that decreases with distance. Anyone caught in the explosion will also be dazed for 3 turns.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tDamage increases with your Mindpower.", "Tú rabia coalesces en un solo punto, y luego explota hacia fuera, despertando enemigos dentro de un radio de %d en todas direcciones. La explosión causa daño a %d y %d en el centro, que disminuye con la distancia. Cualquiera atrapado en la explosión también será aturdido por 3 vueltas.\nAdemás, tu capacidad para canalizar la fuerza con este talento aumentas todo daño crítico por %d %% (actualmente: %d %%)\nEl daño aumentas con tu poder mental.", "tformat")
t("Your fury becomes an unseen force that randomly lashes out at foes around you. For %d turns you strike %d (%d%% chance for %d) nearby target(s) within range %d doing %d damage and %d knockback. The number of extra strikes increases at higher talent levels.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tDamage increases with your Mindpower.", "Tu furia se convierte en una fuerza invisible que aleatoriamente echa a los enemigos a tu alrededor. Para %d se convierte en %d (%d %% posibilidad de %d) objetivo cercano(s) dentro del rango %d haciendo daño %d y %d knockback. El número de huelgas adicionales aumentas a niveles más altos de talento.\nAdemás, tu capacidad para canalizar la fuerza con este talento aumentas todo daño crítico por %d %% (actualmente: %d %%)\nEl daño aumentas con tu poder mental.", "tformat")
t("Focusing your hate, you strike your foe with unseen force for %d damage and %d knockback.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tDamage increases with your Mindpower.", "Centrándote en tu odio, golpeas a tu enemigo con fuerza invisible por daños %d y %d knockback. \n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d% (currently: %d%%)\n\t\t\tDamage increases with your Mindpower.", "tformat")
t("Create a barrier that siphons hate from you at the rate of 0.2 a turn. The barrier will deflect 50%% of incoming damage with the force of your will, up to %d damage. The barrier charges at a rate of 1/%d of its maximum charge per turn.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tThe maximum damage deflected increases with your Mindpower.", "Cree una barrera que los sifones odian de tú a la velocidad de 0,2 a giro. La barrera desviará 50%% de daño entrantes con la fuerza de tu voluntad, hasta daño de %d. La barrera carga a una tasa de 1/%d de tu carga máxima por turno.\nAdemás, tu capacidad para canalizar la fuerza con este talento aumentas todo daño crítico por %d %% (actualmente: %d %%)\nEl daño máximo desviado aumentas con tu poder mental.", "tformat")
t("You rage coalesces at a single point, and then explodes outward, blasting enemies within a radius of %d in all directions. The blast causes %d damage and %d knockback at the center, that decreases with distance. Anyone caught in the explosion will also be dazed for 3 turns.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tDamage increases with your Mindpower.", "Tú rabia coalesces en un solo punto, y luego explota hacia fuera, despertando enemigos dentro de un radio de %d en todas direcciones. La explosión causa daño a %d y %d en el centro, que disminuye con la distancia. Cualquiera atrapado en la explosión también será aturdido por 3 vueltas.\nAdemás, tu capacidad para canalizar la fuerza con este talento aumentas todo daño crítico por %d %% (actualmente: %d %%)\nEl daño aumentas con tu poder mental.", "tformat")
t("Your fury becomes an unseen force that randomly lashes out at foes around you. For %d turns you strike %d (%d%% chance for %d) nearby target(s) within range %d doing %d damage and %d knockback. The number of extra strikes increases at higher talent levels.\n\t\tIn addition, your ability to channel force with this talent increases all critical damage by %d%% (currently: %d%%)\n\t\tDamage increases with your Mindpower.", "Tu furia se convierte en una fuerza invisible que aleatoriamente echa a los enemigos a tu alrededor. Para %d se convierte en %d (%d %% posibilidad de %d) objetivo cercano(s) dentro del rango %d haciendo daño %d y %d knockback. El número de huelgas adicionales aumentas a niveles más altos de talento.\nAdemás, tu capacidad para canalizar la fuerza con este talento aumentas todo daño crítico por %d %% (actualmente: %d %%)\nEl daño aumentas con tu poder mental.", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/gestures.lua"

-- new text
t("Gesture of Pain", "Gesto of Pain", "talent name")
t("You require two free or mindstar-equipped hands to use Gesture of Pain.", "Necesitas dos manos libres o equipadas con estrellas mentales para usar Gesture of Pain.", "logPlayer")
t("%s resists the Gesture of Pain.", "%s resiste la Gestura del dolor.", "logSeen")
t("#F53CBE#You revel in attacking a weakened foe! (+%d hate)", "#F53CBE# You revel in attacking a weakened foe! (+ %d Odio)", "logPlayer")
t("Gesture of Malice", "Gesto of Malice", "talent name")
t("Gesture of Power", "Gesto of Poder", "talent name")
t("Gesture of Guarding", "Gesto of Guarding", "talent name")
t("#F53CBE##Source# lashes back at #Target#!", "#F53CBE##Source# vuelve a caer en #Target#!", "logCombat")
t("Enhance your Gesture of Pain with a malicious curse that causes any victim that is struck to have all resistances lowered by %d%% for %d turns.", "Mejora tu Gestura del Dolor con una maldición maliciosa que haces que cualquier víctima que sea golpeada tenga todas las resistencias bajadas por %d %% para turnos %d.", "tformat")
t("Enhance your mental attacks with a single gesture. You gain +%d mindpower and +%d%% chance to inflict critical damage with mind-based attacks (current chance is %d%%).\n\t\tRequires two free or mindstar-equipped hands; does not require Gesture of Pain to be sustained.", "Mejora tus ataques mentales con un solo gesto. Tú gana +%d fuerza mental y +%d %% oportunidad de infligir daños críticos con ataques basados en la mente (la probabilidad actual es %d %%).\nRequiere dos manos libres o preparadas por la mente; no requiere que Gesture of Pain sea sostenida.", "tformat")
t("Use a gesture of pain in place of a normal attack to assault the minds of your enemies, inflicting between %0.1f and %0.1f mind damage. If the attack succeeds, there is a %d%% chance to stun your opponent for 3 turns.\n\t\tThis strike replaces your melee physical and checks your Mindpower against your opponent's Mental Save, and is thus not affected by your Accuracy or the enemy's Defense. The base damage (doubled) and the critical chance of any Mindstars equipped are added in when this attack is performed.\n\t\tThis talent requires two free or mindstar-equipped hands and has a 25%% chance to inflict brainlock, which can critically hit. The damage will increase with your Mindpower.\n\t\tIf attacking with two mindstars the attack will trigger their proc effects, if any.\n\t\tMindstars bonuses from damage and physical criticals: (+%d damage, +%d critical chance)", "Use un gesto de dolor en lugar de un ataque normal para atacar las mentes de sus enemigos, infligiendo entre %0.1f y %0.1f daño mental. Si el ataque tienes éxito, hay una oportunidad de %d %% para aturdir a tu oponente durante 3 turnos.\nEsta huelga sustituye a tu cuerpo a cuerpo física y verifica tu poder mental contra el Ahorro Mental de tu oponente, y por lo tanto no se ve afectada por tu exactitud o la Defensa del enemigo. El daño base (doblado) y la oportunidad crítica de cualquier Mindstars equipados se añaden cuando se realiza este ataque.\nEste talento requiere dos manos libres o equipadas con estrellas mentales y tienes una oportunidad de 25%% para infligir bloqueo cerebral, que puedes golpear críticamente. El daño aumentará con tu poder mental.\nSi atacan con dos estrellas mentales el ataque desencadenará sus efectos proc, si los hay.\nMindstars bonificaciones por daños y críticos físicos: (+%d daño, +%d riesgo crítico)", "tformat")
t("Enhance your mental attacks with a single gesture. You gain +%d mindpower and +%d%% chance to inflict critical damage with mind-based attacks (current chance is %d%%).\n\t\tRequires two free or mindstar-equipped hands; does not require Gesture of Pain to be sustained.", "Mejora tus ataques mentales con un solo gesto. Tú gana +%d fuerza mental y +%d %% oportunidad de infligir daños críticos con ataques basados en la mente (la probabilidad actual es %d %%).\nRequiere dos manos libres o preparadas por la mente; no requiere que Gesture of Pain sea sostenida.", "tformat")
t("Use a gesture of pain in place of a normal attack to assault the minds of your enemies, inflicting between %0.1f and %0.1f mind damage. If the attack succeeds, there is a %d%% chance to stun your opponent for 3 turns.\n\t\tThis strike replaces your melee physical and checks your Mindpower against your opponent's Mental Save, and is thus not affected by your Accuracy or the enemy's Defense. The base damage (doubled) and the critical chance of any Mindstars equipped are added in when this attack is performed.\n\t\tThis talent requires two free or mindstar-equipped hands and has a 25%% chance to inflict brainlock, which can critically hit. The damage will increase with your Mindpower.\n\t\tIf attacking with two mindstars the attack will trigger their proc effects, if any.\n\t\tMindstars bonuses from damage and physical criticals: (+%d damage, +%d critical chance)", "Use un gesto de dolor en lugar de un ataque normal para atacar las mentes de sus enemigos, infligiendo entre %0.1f y %0.1f daño mental. Si el ataque tienes éxito, hay una oportunidad de %d %% para aturdir a tu oponente durante 3 turnos.\nEsta huelga sustituye a tu cuerpo a cuerpo física y verifica tu poder mental contra el Ahorro Mental de tu oponente, y por lo tanto no se ve afectada por tu exactitud o la Defensa del enemigo. El daño base (doblado) y la oportunidad crítica de cualquier Mindstars equipados se añaden cuando se realiza este ataque.\nEste talento requiere dos manos libres o equipadas con estrellas mentales y tienes una oportunidad de 25%% para infligir bloqueo cerebral, que puedes golpear críticamente. El daño aumentará con tu poder mental.\nSi atacan con dos estrellas mentales el ataque desencadenará sus efectos proc, si los hay.\nMindstars bonificaciones por daños y críticos físicos: (+%d daño, +%d riesgo crítico)", "tformat")
t("Enhance your mental attacks with a single gesture. You gain +%d mindpower and +%d%% chance to inflict critical damage with mind-based attacks (current chance is %d%%).\n\t\tRequires two free or mindstar-equipped hands; does not require Gesture of Pain to be sustained.", "Mejora tus ataques mentales con un solo gesto. Tú gana +%d fuerza mental y +%d %% oportunidad de infligir daños críticos con ataques basados en la mente (la probabilidad actual es %d %%).\nRequiere dos manos libres o preparadas por la mente; no requiere que Gesture of Pain sea sostenida.", "tformat")
t("You guard against melee damage with a sweep of your hand. So long as you can use Gestures (Requires two free or mindstar-equipped hands), you deflect up to %d damage (%0.1f%% of your best free hand melee damage) from up to %0.1f melee attack(s) each turn (based on your cunning). Deflected attacks cannot be crits.\n\t\tIf Gesture of Pain is active, you also have a %0.1f%% chance to counterattack.", "Vigilas contra el daño de la cuerpo a cuerpo con un barrido de la mano. Mientras puedas utilizar Gestures (Requiere dos manos libres o equipadas con estrellas mentales), desvíes hasta los daño de %d (%0.1f %% de tu mejor daño de la mano libre) de hasta los ataques de %0.1f cuerpo a cuerpo(s) cada turno (basado en tu astucia). Los ataques desviados no pueden ser criminales.\nSi Gesture of Pain estás activo, también tienes una oportunidad de %0.1f %% para contrarrestar el ataque.", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/gloom.lua"

-- new text
t("Gloom", "Penumbra", "talent name")
t("#F53CBE#Your heart hardens as a powerful foe enters your gloom! (+%d hate)", "#F53CBE# Tu corazón se endurece como un enemigo poderoso entra en tu gloom! (+ %d Odio)", "logPlayer")
t("Weakness", "Debilidad", "talent name")
t("Mindrot", "mindrot", "talent name")
t("Sanctuary", "Santuario", "talent name")
t("A terrible gloom surrounds you, affecting all those who approach to within radius 3. At the end of each game turn, those caught in your gloom must save against your Mindpower, or have a %d%% chance to suffer from slowness (30%%), stun or confusion (30%%) for %d turns.\n\t\tThe chance increases with your mind speed.\n\t\tThis ability is innate, and carries no cost to activate or deactivate.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Una terrible oscuridad te rodea, afectando a todos los que se acercan al radio 3. Al final de cada turno de juego, los atrapados en tu gloom deben salvar contra tu poder mental, o tener una %d %% oportunidad de sufrir de la lentitud (30%%), stun o confusión (30%%) para turnos de %d.\nLa oportunidad aumentas con tu velocidad mental.\nEsta capacidad es innata, y no tienes costo para activar o desactivar.\nCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("Each turn, those caught in your gloom must save against your Mindpower, or have a %d%% chance to be crippled by fear for %d turns, reducing damage they inflict by %d%%. The first time you melee strike a foe after they have been weakened will give you %d hate.\n\t\tThe chance increases with your mind speed.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Cada giro, los atrapados en tu gloom deben salvar contra tu poder mental, o tener una oportunidad de %d %% para ser lisiados por el miedo por turnos %d, reduciendo los daños que infligen por %d %%. La primera vez que cuerpo a cuerpo golpear a un enemigo después de que se han debilitado le dará a %d odio.\nLa oportunidad aumentas con tu velocidad mental.\nCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("Every turn, all enemies in your gloom take %0.2f mind damage and %0.2f darkness damage.\n\t\tThis damage is increased by your global speed but only happens ever game turn.\n\t\tThe damage scales with your Mindpower.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Cada vuelta, todos los enemigos en tu gloom toman %0.2f daño mental y %0.2f daño de la oscuridad. Este daño es aumentado por tu velocidad global pero sólo sucede siempre el turno del juego.\n\t\t El daño escala con tu poder mental.\n\t\tCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("Your gloom has become a sanctuary from the outside world. Damage from any attack that originates beyond the boundary of your gloom is reduced by %d%%.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Tu gloom se ha convertido en un santuario del mundo exterior. Los daño de cualquier ataque que se origina más allá del límite de tu gloom se reducen por %d %%.\nCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("A terrible gloom surrounds you, affecting all those who approach to within radius 3. At the end of each game turn, those caught in your gloom must save against your Mindpower, or have a %d%% chance to suffer from slowness (30%%), stun or confusion (30%%) for %d turns.\n\t\tThe chance increases with your mind speed.\n\t\tThis ability is innate, and carries no cost to activate or deactivate.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Una terrible oscuridad te rodea, afectando a todos los que se acercan al radio 3. Al final de cada turno de juego, los atrapados en tu gloom deben salvar contra tu poder mental, o tener una %d %% oportunidad de sufrir de la lentitud (30%%), stun o confusión (30%%) para turnos de %d.\nLa oportunidad aumentas con tu velocidad mental.\nEsta capacidad es innata, y no tienes costo para activar o desactivar.\nCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("Each turn, those caught in your gloom must save against your Mindpower, or have a %d%% chance to be crippled by fear for %d turns, reducing damage they inflict by %d%%. The first time you melee strike a foe after they have been weakened will give you %d hate.\n\t\tThe chance increases with your mind speed.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Cada giro, los atrapados en tu gloom deben salvar contra tu poder mental, o tener una oportunidad de %d %% para ser lisiados por el miedo por turnos %d, reduciendo los daños que infligen por %d %%. La primera vez que cuerpo a cuerpo golpear a un enemigo después de que se han debilitado le dará a %d odio.\nLa oportunidad aumentas con tu velocidad mental.\nCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("Every turn, all enemies in your gloom take %0.2f mind damage and %0.2f darkness damage.\n\t\tThis damage is increased by your global speed but only happens ever game turn.\n\t\tThe damage scales with your Mindpower.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Cada vuelta, todos los enemigos en tu gloom toman %0.2f daño mental y %0.2f daño de la oscuridad. Este daño es aumentado por tu velocidad global pero sólo sucede siempre el turno del juego.\n\t\t El daño escala con tu poder mental.\n\t\tCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("Your gloom has become a sanctuary from the outside world. Damage from any attack that originates beyond the boundary of your gloom is reduced by %d%%.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Tu gloom se ha convertido en un santuario del mundo exterior. Los daño de cualquier ataque que se origina más allá del límite de tu gloom se reducen por %d %%.\nCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("A terrible gloom surrounds you, affecting all those who approach to within radius 3. At the end of each game turn, those caught in your gloom must save against your Mindpower, or have a %d%% chance to suffer from slowness (30%%), stun or confusion (30%%) for %d turns.\n\t\tThe chance increases with your mind speed.\n\t\tThis ability is innate, and carries no cost to activate or deactivate.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Una terrible oscuridad te rodea, afectando a todos los que se acercan al radio 3. Al final de cada turno de juego, los atrapados en tu gloom deben salvar contra tu poder mental, o tener una %d %% oportunidad de sufrir de la lentitud (30%%), stun o confusión (30%%) para turnos de %d.\nLa oportunidad aumentas con tu velocidad mental.\nEsta capacidad es innata, y no tienes costo para activar o desactivar.\nCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("Each turn, those caught in your gloom must save against your Mindpower, or have a %d%% chance to be crippled by fear for %d turns, reducing damage they inflict by %d%%. The first time you melee strike a foe after they have been weakened will give you %d hate.\n\t\tThe chance increases with your mind speed.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Cada giro, los atrapados en tu gloom deben salvar contra tu poder mental, o tener una oportunidad de %d %% para ser lisiados por el miedo por turnos %d, reduciendo los daños que infligen por %d %%. La primera vez que cuerpo a cuerpo golpear a un enemigo después de que se han debilitado le dará a %d odio.\nLa oportunidad aumentas con tu velocidad mental.\nCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("Every turn, all enemies in your gloom take %0.2f mind damage and %0.2f darkness damage.\n\t\tThis damage is increased by your global speed but only happens ever game turn.\n\t\tThe damage scales with your Mindpower.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Cada vuelta, todos los enemigos en tu gloom toman %0.2f daño mental y %0.2f daño de la oscuridad. Este daño es aumentado por tu velocidad global pero sólo sucede siempre el turno del juego.\n\t\t El daño escala con tu poder mental.\n\t\tCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")
t("Your gloom has become a sanctuary from the outside world. Damage from any attack that originates beyond the boundary of your gloom is reduced by %d%%.\n\t\tEach point in Gloom talents increases your Mindpower (current total: %d).", "Tu gloom se ha convertido en un santuario del mundo exterior. Los daño de cualquier ataque que se origina más allá del límite de tu gloom se reducen por %d %%.\nCada punto en los talentos de Gloom aumentas tu poder mental ( total actual: %d).", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/one-with-shadows.lua"

-- new text
t("Shadow Senses", "Sombra Sentidos", "talent name")
t("Shadows Empathy", "Sombras Empathy", "talent name")
t("Shadow Transposition", "Sombra Transposition", "talent name")
t("Shadow Decoy", "Sombra Decoy", "talent name")
t("#GOLD#(%d decoy)#LAST#", "#GOLD#( %d decoy)#", "tformat")
t("#GOLD#%d decoy#LAST#", "#GOLD# %d Decoy#LAST#", "tformat")
t("Your awareness extends to your shadows.\n\t\tYou always know exactly where your shadows are and can perceive any foe within %d tiles of their vision.", "Tu conciencia se extiende a tus sombras.\n\t\tSiempre sabes exactamente dónde están tus sombras y puedes percibir cualquier enemigo dentro de las tablas %d de tu visión.", "tformat")
t("Observers find it difficult to tell you and your shadows apart.\n\t\tYou can target a shadow in radius %d and instantly trade places with it.\n\t\t%d random negative physical or magical effects are transferred from you to the chosen shadow in the process.", "Los observadores encuentran difícil decirte y tus sombras separadas.\nUsted puedes apuntar una sombra en %d radius e instantáneamente cambiar lugares con él.\n%d efectos negativos aleatorios físicos o mágicos son transferidos de tú a la sombra elegida en el proceso.", "tformat")
t("Your awareness extends to your shadows.\n\t\tYou always know exactly where your shadows are and can perceive any foe within %d tiles of their vision.", "Tu conciencia se extiende a tus sombras.\n\t\tSiempre sabes exactamente dónde están tus sombras y puedes percibir cualquier enemigo dentro de las tablas %d de tu visión.", "tformat")
t("You empathy with your shadows causes the line between you and your shadows to blur.\n\t\tYou lose %d%% light resistance, but gain %d%% darkness resistance and affinity. You also gain %0.2f%% all resistance for each shadow in your party.", "Tú empatía con sus sombras haces que la línea entre tú y sus sombras se borre.\nPierdes resistencia a la luz %d %%, pero ganas resistencia a las tinieblas %d y afinidad. También ganas %0.2f %% toda resistencia a cada sombra en tu partido.", "tformat")
t("Observers find it difficult to tell you and your shadows apart.\n\t\tYou can target a shadow in radius %d and instantly trade places with it.\n\t\t%d random negative physical or magical effects are transferred from you to the chosen shadow in the process.", "Los observadores encuentran difícil decirte y tus sombras separadas.\nUsted puedes apuntar una sombra en %d radius e instantáneamente cambiar lugares con él.\n%d efectos negativos aleatorios físicos o mágicos son transferidos de tú a la sombra elegida en el proceso.", "tformat")
t("Your shadows guard you with their lives.\n\t\tWhen you would receive a fatal blow, you instantly transpose with a random shadow that takes the blow instead, putting this talent on cooldown.\n\t\tFor the next 4 turns you only die if you reach -%d life.\n\t\tEffect increases with Mindpower.", "Tus sombras te protegen con sus vidas. \n\t\tCuando recibirías un golpe mortal, instantáneamente transponerías con una sombra aleatoria que toma el golpe en tu lugar, poniendo este talento en la refrigeración. Para los próximos 4 turnos sólo mueres si alcanzas -%d vida.\n\t\tEffect aumentas con fuerza mental.", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/cursed/predator.lua"

-- new text
t("Predator", "Depredador", "talent name")
t("Improve your predation by learning from past hunts. You gain %0.2f accuracy and %0.2f armor penetration against foes for each foe of that type you have previously slain, to a maximum of %d accuracy and %d apr.", "Mejora tu predación aprendiendo de cazas pasadas. Ganas %0.2f exactitud y %0.2f penetración de armadura contra enemigos para cada enemigo de ese tipo que previamente ha matado, a un máximo de %d exactitud y %d apr.", "tformat")
t("Savage Hunter", "Salvaje Hunter", "talent name")
t("%s's cursed miasma", "El maldito miasma%s", "tformat")
t("Shrouded Hunter", "de Hunter", "talent name")
t("Mark Prey", "Marca Prey", "talent name")
t("Focus your predation on the most worthy prey. Upon entering a level for the first time, up to %d foes are marked as your prey. You gain vision of them, wherever they are. Additionally, all damage you receive from their subtype is reduced by %d%%.", "Enfoque tu predación en la presa más digna. Al entrar en un nivel por primera vez, hasta %d los enemigos están marcados como tu presa. Ganas la visión de ellos, dondequiera que estén. Además, todos los daños que recibe de tu subtipo se reducen por %d%%.", "tformat")
t("Upon making a critical melee attack the savagery of your predation causes a Cursed Miasma to begin permeating your hunting grounds.\n\t\tThe miasma will seep from %d locations, including your own, within radius %d, deals %0.2f damage split between Darkness and Mind and blocks sight.\n\t\tPrey lost within your miasma have a %d%% chance to lose track of you and may mistake friends for foe.\n\t\tSavage Hunter costs #ffa0ff#8 Hate#LAST# on trigger and does not trigger when you're in Cursed Miasma.", "Al hacer un cuerpo a cuerpo crítico ataque la salvajía de tu predación haces que un Miasma Cursado comience a permear sus campos de caza.\nEl miasma secará de lugares de %d, incluyendo el tuyo, dentro del radio %d, se ocupa de la división de daños %0.2f entre la Oscuridad y la Mente y bloquea la vista.\nPrey perdido dentro de tu miasma tienen una oportunidad de %d %% para perder el seguimiento de tú y puedes confundir amigos para enemigo.\nSavage Hunter cuesta #ffa0ff#8 Hate#LAST# en gatillo y no activa cuando estás en Cursed Miasma.", "tformat")
t("While shrouded in cursed miasma you gain stealth (%d power) and %d physical power.\n\t\tThe stealth power and physical power will increase with your mindpower.", "Mientras se deslumbraba en el miasma maldecido ganas el sigilo (%d poder) y %d poder físico. El poder robótico y el poder físico aumentarán con tu poder mental.", "tformat")
t("Upon making a critical melee attack the savagery of your predation causes a Cursed Miasma to begin permeating your hunting grounds.\n\t\tThe miasma will seep from %d locations, including your own, within radius %d, deals %0.2f damage split between Darkness and Mind and blocks sight.\n\t\tPrey lost within your miasma have a %d%% chance to lose track of you and may mistake friends for foe.\n\t\tSavage Hunter costs #ffa0ff#8 Hate#LAST# on trigger and does not trigger when you're in Cursed Miasma.", "Al hacer un cuerpo a cuerpo crítico ataque la salvajía de tu predación haces que un Miasma Cursado comience a permear sus campos de caza.\nEl miasma secará de lugares de %d, incluyendo el tuyo, dentro del radio %d, se ocupa de la división de daños %0.2f entre la Oscuridad y la Mente y bloquea la vista.\nPrey perdido dentro de tu miasma tienen una oportunidad de %d %% para perder el seguimiento de tú y puedes confundir amigos para enemigo.\nSavage Hunter cuesta #ffa0ff#8 Hate#LAST# en gatillo y no activa cuando estás en Cursed Miasma.", "tformat")
t("While shrouded in cursed miasma you gain stealth (%d power) and %d physical power.\n\t\tThe stealth power and physical power will increase with your mindpower.", "Mientras se deslumbraba en el miasma maldecido ganas el sigilo (%d poder) y %d poder físico. El poder robótico y el poder físico aumentarán con tu poder mental.", "tformat")
t("Upon making a critical melee attack the savagery of your predation causes a Cursed Miasma to begin permeating your hunting grounds.\n\t\tThe miasma will seep from %d locations, including your own, within radius %d, deals %0.2f damage split between Darkness and Mind and blocks sight.\n\t\tPrey lost within your miasma have a %d%% chance to lose track of you and may mistake friends for foe.\n\t\tSavage Hunter costs #ffa0ff#8 Hate#LAST# on trigger and does not trigger when you're in Cursed Miasma.", "Al hacer un cuerpo a cuerpo crítico ataque la salvajía de tu predación haces que un Miasma Cursado comience a permear sus campos de caza.\nEl miasma secará de lugares de %d, incluyendo el tuyo, dentro del radio %d, se ocupa de la división de daños %0.2f entre la Oscuridad y la Mente y bloquea la vista.\nPrey perdido dentro de tu miasma tienen una oportunidad de %d %% para perder el seguimiento de tú y puedes confundir amigos para enemigo.\nSavage Hunter cuesta #ffa0ff#8 Hate#LAST# en gatillo y no activa cuando estás en Cursed Miasma.", "tformat")
t("While shrouded in cursed miasma you gain stealth (%d power) and %d physical power.\n\t\tThe stealth power and physical power will increase with your mindpower.", "Mientras se deslumbraba en el miasma maldecido ganas el sigilo (%d poder) y %d poder físico. El poder robótico y el poder físico aumentarán con tu poder mental.", "tformat")

