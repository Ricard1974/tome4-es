-- section "mod-tome/data/chats/gates-of-morning-welcome.lua"

-- new text
t("My lady, I am indeed a stranger in these lands. I come from the west, from Maj'Eyal.", "Mi señora, de hecho soy un extraño en estas tierras. Vengo del oeste, de Maj'Eyal.", "_t")
t("Sorry, I have to go!", "¡Lo siento, tengo que irme!", "chat_gates-of-morning-welcome")
t("It seems that I am stranded in these unfamiliar lands. #LIGHT_GREEN#*Tell her about your hunt for orcs and your encounter with Fillarel.*#WHITE#", "Parece que estoy varado en estas tierras desconocidas. #LIGHT_GREEN# #Cuéntale sobre tu búsqueda de orcos y tu encuentro con Fillarel. ##", "_t")
t("Sun Paladins? What do you mean? We know of no such thing where I come from.", "¿Sun Paladins? ¿Qué quieres decir? No sabemos de dónde vengo.", "_t")
t("You have a noble spirit, my lady.", "Tienes un espíritu noble, mi señora.", "_t")
t("Thank you, my lady.", "Gracias, mi señora.", "_t")

