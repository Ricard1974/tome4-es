-- section "mod-tome/data/talents/misc/misc.lua"

-- new text
t("base", "base", "talent category")
t("class", "clase", "talent type")
t("The basic talents defining a class.", "Los talentos básicos que definen una clase.", "_t")
t("race", "raza", "talent type")
t("The various racial bonuses a character can have.", "Los diversos bonos raciales que un personaje puedes tener.", "_t")
t("inscriptions", "inscripciones", "talent category")
t("infusions", "infusiones", "talent type")
t("Infusions are not class abilities, you must find them or learn them from other people.", "Las infusiones no son habilidades de clase, debes encontrarlas o aprenderlas de otras personas.", "_t")
t("runes", "runas", "talent type")
t("Runes are not class abilities, you must find them or learn them from other people.", "Las carreras no son habilidades de clase, debes encontrarlas o aprenderlas de otras personas.", "_t")
t("taints", "máculas", "talent type")
t("Taints are not class abilities, you must find them or learn them from other people.", "Las habilidades no son habilidades de clase, debes encontrarlas o aprenderlas de otras personas.", "_t")
t("Attack", "Ataque", "talent name")
t("#Source# attacks empty space.", "#Source# atacas espacio vacío.", "logCombat")
t("Hack and slash, baby!", "Hack y slash, bebé!", "tformat")
t("Psi Pool", "Psi Piscina", "talent name")
t("Feedback Pool", "Feedback Piscina", "talent name")
t("Mana Pool", "Mana Piscina", "talent name")
t("Soul Pool", "Alma Piscina", "talent name")
t("Vim Pool", "Vim Piscina", "talent name")
t("Stamina Pool", "Stamina Piscina", "talent name")
t("Equilibrium Pool", "Equilibrium Piscina", "talent name")
t("Positive Pool", "Positive Piscina", "talent name")
t("Negative Pool", "Negative Piscina", "talent name")
t("Hate Pool", "Hate Piscina", "talent name")
t("#F53CBE#You have taken the life of an experienced foe!", "#F53CBE# Has tomado la vida de un enemigo experimentado!", "_t")
t("#F53CBE#Your hate has conquered a great adversary!", "Tu odio ha conquistado a un gran adversario!", "_t")
t("#F53CBE#An elite foe has fallen to your hate!", "#F53CBE# ¡Un enemigo de élite ha caído en tu odio!", "_t")
t("Paradox Pool", "Paradox Piscina", "talent name")
t("Hunted!", "Hunted!", "talent name")
t("Teleport: Angolwen", "Teletransporte: Angolwen", "talent name")
t("The spell fizzles...", "El hechizo brilla...", "logPlayer")
t("There are creatures that could be watching you; you cannot take the risk.", "Hay criaturas que podrían estar observándote; no puedes correr el riesgo.", "log")
t("Timeport: Point Zero", "Timeport: Punto Cero", "talent name")
t("Relentless Pursuit", "Pursuit incesante", "talent name")
t("%s: Reducing duration of %s, using %s, by %d", "%s: Reducción de la duración de %s, utilizando %s, por %d", "tformat")
t(" %s effect durations -%d turns", "%s duración del efecto -%d turnos", "tformat")
t("Teleport to the ground", "Teletransporte to the ground", "talent name")
t("You cannot teleport there.", "No puedes teletransportar allí.", "log")
t("Fire a blast of energy", "Fuego a blast of energy", "talent name")
t("High Planetary Orbit", "Orbito planetario alto", "talent name")
t("You are hunted!.\n\t\tThere is a %d%% chance each turn that all foes in a %d radius get a glimpse of your position for 30 turns.", "¡Estás cazado!\nHay una posibilidad de %d %% cada vuelta que todos los enemigos en un radio %d consiguen un vistazo de tu posición para 30 vueltas.", "tformat")
t("Not the Master himself, nor all the orcs in fallen Reknor, nor even the terrifying unknown beyond Reknor's portal could slow your pursuit of the Staff of Absorption.\n\t\tChildren will hear of your relentlessness in song for years to come.\n\t\tWhen activated, this ability reduces the duration of all active detrimental effects by 20%% of your associated save value or 2, whichever is greater:\n\t\t%s", "No el mismo Maestro, ni todos los orcos en Reknor caído, ni siquiera el aterrador desconocido más allá del portal de Reknor podría retrasar tu búsqueda del Personal de Absorción.\nLos niños escucharán de tu implacable canción durante años.\nCuando se activa, esta habilidad reduces la duración de todos los efectos perjudiciales activos por 20%% de tu valor de ahorro asociado o 2, lo que sea mayor:\n%s", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/misc/npcs.lua"

