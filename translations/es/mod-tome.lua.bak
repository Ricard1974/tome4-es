t("Infusion: Primal", "Infusión: Primal", "talent name")
t("Activate the infusion to heal for %d%% of all damage taken (calculated before resistances) and reduce the duration of a random debuff by %d each turn for %d turns.", "Activar la infusión para sanar para %d%% de todos los daños tomados (calculados antes de las resistencias) y reducir la duración de una debuff al azar por %d cada vuelta para %d vueltas.", "tformat")
t("affinity %d%%; reduction %d; dur %d; cd %d", "affinity %d%%; reduction %d; dur %d; cd %d", "tformat")
t("Infusion: Movement", "Infusión: Movement", "talent name")
t("speed %d%%; cd %d", "velocidad %d%%; cd %d", "tformat")
