------------------------------------------------
section "mod-tome/data/birth/classes/warrior.lua"


-- new text
--[==[
t("Warrior", "Warrior", "birth descriptor name")
t("Warriors train in all aspects of physical combat. They can be juggernauts of destruction wielding two-handed greatswords, or massive iron-clad protectors with gleaming shields.", "Warriors train in all aspects of physical combat. They can be juggernauts of destruction wielding two-handed greatswords, or massive iron-clad protectors with gleaming shields.", "_t")
t("Berserker", "Berserker", "birth descriptor name")
t("A Berserker wields huge two-handed weapons of destruction, bringing pain and death to his foes as he cleaves them in two.", "A Berserker wields huge two-handed weapons of destruction, bringing pain and death to his foes as he cleaves them in two.", "_t")
t("A Berserker usually forfeits all ideas of self-defense to concentrate on what he does best: killing things.", "A Berserker usually forfeits all ideas of self-defense to concentrate on what he does best: killing things.", "_t")
t("Their most important stats are: Strength and Constitution", "Their most important stats are: Strength and Constitution", "_t")
t("#GOLD#Stat modifiers:", "#GOLD#Stat modifiers:", "_t")
t("#LIGHT_BLUE# * +5 Strength, +1 Dexterity, +3 Constitution", "#LIGHT_BLUE# * +5 Strength, +1 Dexterity, +3 Constitution", "_t")
t("#LIGHT_BLUE# * +0 Magic, +0 Willpower, +0 Cunning", "#LIGHT_BLUE# * +0 Magic, +0 Willpower, +0 Cunning", "_t")
t("#GOLD#Life per level:#LIGHT_BLUE# +3", "#GOLD#Life per level:#LIGHT_BLUE# +3", "_t")
t("Bulwark", "Bulwark", "birth descriptor name")
t("A Bulwark specializes in weapon and shield combat, rarely leaving the cover of her many protective techniques.", "A Bulwark specializes in weapon and shield combat, rarely leaving the cover of her many protective techniques.", "_t")
t("A good Bulwark is able to withstand terrible attacks from all sides, protected by her shield, and when the time comes lash out at her foes with incredible strength.", "A good Bulwark is able to withstand terrible attacks from all sides, protected by her shield, and when the time comes lash out at her foes with incredible strength.", "_t")
t("Their most important stats are: Strength and Dexterity", "Their most important stats are: Strength and Dexterity", "_t")
t("#LIGHT_BLUE# * +5 Strength, +2 Dexterity, +2 Constitution", "#LIGHT_BLUE# * +5 Strength, +2 Dexterity, +2 Constitution", "_t")
t("#GOLD#Life per level:#LIGHT_BLUE# +6", "#GOLD#Life per level:#LIGHT_BLUE# +6", "_t")
t("Archer", "Archer", "birth descriptor name")
t("Archers are dexterous ranged fighters, able to pin their foes to the ground and rain down a carpet of arrows on them.", "Archers are dexterous ranged fighters, able to pin their foes to the ground and rain down a carpet of arrows on them.", "_t")
t("Skilled archers can fire special shots that pierce, cripple or pin their foes.", "Skilled archers can fire special shots that pierce, cripple or pin their foes.", "_t")
t("Archers can become good with either longbows or slings.", "Archers can become good with either longbows or slings.", "_t")
t("Their most important stats are: Dexterity and Strength (when using bows) or Cunning (when using slings)", "Their most important stats are: Dexterity and Strength (when using bows) or Cunning (when using slings)", "_t")
t("#LIGHT_BLUE# * +2 Strength, +5 Dexterity, +0 Constitution", "#LIGHT_BLUE# * +2 Strength, +5 Dexterity, +0 Constitution", "_t")
t("#LIGHT_BLUE# * +0 Magic, +0 Willpower, +2 Cunning", "#LIGHT_BLUE# * +0 Magic, +0 Willpower, +2 Cunning", "_t")
t("#GOLD#Life per level:#LIGHT_BLUE# +0", "#GOLD#Life per level:#LIGHT_BLUE# +0", "_t")
t("Arcane Blade", "Arcane Blade", "birth descriptor name")
t("The Arcane Blade is a warrior who has been touched by the gift of magic.", "The Arcane Blade is a warrior who has been touched by the gift of magic.", "_t")
t("Their use of magic is innate and not really studied; as such they do not naturally regenerate mana and must use external means of recharging.", "Their use of magic is innate and not really studied; as such they do not naturally regenerate mana and must use external means of recharging.", "_t")
t("They can cast spells from a limited selection but have the unique capacity to 'channel' their attack spells through their melee attacks.", "They can cast spells from a limited selection but have the unique capacity to 'channel' their attack spells through their melee attacks.", "_t")
t("They are adept with two-handed weapons, for the sheer destruction they can bring.", "They are adept with two-handed weapons, for the sheer destruction they can bring.", "_t")
t("Their most important stats are: Strength, Cunning and Magic", "Their most important stats are: Strength, Cunning and Magic", "_t")
t("#LIGHT_BLUE# * +3 Strength, +0 Dexterity, +0 Constitution", "#LIGHT_BLUE# * +3 Strength, +0 Dexterity, +0 Constitution", "_t")
t("#LIGHT_BLUE# * +3 Magic, +0 Willpower, +3 Cunning", "#LIGHT_BLUE# * +3 Magic, +0 Willpower, +3 Cunning", "_t")
t("#GOLD#Life per level:#LIGHT_BLUE# +2", "#GOLD#Life per level:#LIGHT_BLUE# +2", "_t")
t("Brawler", "Brawler", "birth descriptor name")
t("Though you may fight alone against many, destined to fight till you die, still you do not relent. In a ring of blood you learn that a pair of fists can face the world.", "Though you may fight alone against many, destined to fight till you die, still you do not relent. In a ring of blood you learn that a pair of fists can face the world.", "_t")
t("The ravages of the Spellblaze stretched armies thin and left many unprotected. Not everyone could afford the luxury of a weapon.", "The ravages of the Spellblaze stretched armies thin and left many unprotected. Not everyone could afford the luxury of a weapon.", "_t")
t("Without steel or iron, poor communities of all races turned to the strength of their own bodies for defense against the darkness.", "Without steel or iron, poor communities of all races turned to the strength of their own bodies for defense against the darkness.", "_t")
t("Whether a pit-fighter, a boxer, or just an amateur practitioner, the Brawler's skills are still handy today.", "Whether a pit-fighter, a boxer, or just an amateur practitioner, the Brawler's skills are still handy today.", "_t")
t("Many of the Brawler's abilities will earn combo points which they can use on finishing moves that will have added effect.", "Many of the Brawler's abilities will earn combo points which they can use on finishing moves that will have added effect.", "_t")
t("The unarmed fighting styles the Brawler uses rely on maneuverability and having both hands available. As such, they cannot make use of their training wearing massive armour or while a weapon or shield is equipped.", "The unarmed fighting styles the Brawler uses rely on maneuverability and having both hands available. As such, they cannot make use of their training wearing massive armour or while a weapon or shield is equipped.", "_t")
t("Their most important stats are: Strength, Dexterity, and Cunning", "Their most important stats are: Strength, Dexterity, and Cunning", "_t")
t("#LIGHT_BLUE# * +3 Strength, +3 Dexterity, +0 Constitution", "#LIGHT_BLUE# * +3 Strength, +3 Dexterity, +0 Constitution", "_t")
t("#LIGHT_BLUE# * +0 Magic, +0 Willpower, +3 Cunning", "#LIGHT_BLUE# * +0 Magic, +0 Willpower, +3 Cunning", "_t")
--]==]

------------------------------------------------
section "mod-tome/data/birth/classes/wilder.lua"


-- new text
--[==[
t("Wilder", "Wilder", "birth descriptor name")
t("Natural abilities can go beyond mere skill. Experience the true powers of nature to learn of its amazing gifts.", "Natural abilities can go beyond mere skill. Experience the true powers of nature to learn of its amazing gifts.", "_t")
t("Wilders are one with nature, in one manner or another. There are as many different Wilders as there are aspects of nature.", "Wilders are one with nature, in one manner or another. There are as many different Wilders as there are aspects of nature.", "_t")
t("They can take on the aspects of creatures, summon creatures to them, feel the druidic call, ...", "They can take on the aspects of creatures, summon creatures to them, feel the druidic call, ...", "_t")
t("Summoner", "Summoner", "birth descriptor name")
t("Not all might comes from within. Hear the invocations of nature, hear its calling power. See that from without we can find our true strengths.", "Not all might comes from within. Hear the invocations of nature, hear its calling power. See that from without we can find our true strengths.", "_t")
t("Summoners never fight alone. They are always ready to summon one of their many minions to fight at their side.", "Summoners never fight alone. They are always ready to summon one of their many minions to fight at their side.", "_t")
t("Summons can range from a combat hound to a fire drake.", "Summons can range from a combat hound to a fire drake.", "_t")
t("Their most important stats are: Willpower and Cunning", "Their most important stats are: Willpower and Cunning", "_t")
t("#GOLD#Stat modifiers:", "#GOLD#Stat modifiers:", "_t")
t("#LIGHT_BLUE# * +0 Strength, +1 Dexterity, +0 Constitution", "#LIGHT_BLUE# * +0 Strength, +1 Dexterity, +0 Constitution", "_t")
t("#LIGHT_BLUE# * +0 Magic, +5 Willpower, +3 Cunning", "#LIGHT_BLUE# * +0 Magic, +5 Willpower, +3 Cunning", "_t")
t("#GOLD#Life per level:#LIGHT_BLUE# +0", "#GOLD#Life per level:#LIGHT_BLUE# +0", "_t")
t("Max summons: %d", "Max summons: %d", "tformat")
t("Wyrmic", "Wyrmic", "birth descriptor name")
t("Sleek, majestic, powerful... In the path of dragons we walk, and their breath is our breath. See their beating hearts with your eyes and taste their majesty between your teeth.", "Sleek, majestic, powerful... In the path of dragons we walk, and their breath is our breath. See their beating hearts with your eyes and taste their majesty between your teeth.", "_t")
t("Wyrmics are fighters who have learnt how to mimic some of the aspects of the dragons.", "Wyrmics are fighters who have learnt how to mimic some of the aspects of the dragons.", "_t")
t("They have access to talents normally belonging to the various kind of drakes.", "They have access to talents normally belonging to the various kind of drakes.", "_t")
t("Their most important stats are: Strength and Willpower", "Their most important stats are: Strength and Willpower", "_t")
t("#LIGHT_BLUE# * +5 Strength, +0 Dexterity, +1 Constitution", "#LIGHT_BLUE# * +5 Strength, +0 Dexterity, +1 Constitution", "_t")
t("#LIGHT_BLUE# * +0 Magic, +3 Willpower, +0 Cunning", "#LIGHT_BLUE# * +0 Magic, +3 Willpower, +0 Cunning", "_t")
t("#GOLD#Life per level:#LIGHT_BLUE# +2", "#GOLD#Life per level:#LIGHT_BLUE# +2", "_t")
t("Oozemancer", "Oozemancer", "birth descriptor name")
t("Magic must fail, magic must lose, nothing arcane can face the ooze...", "Magic must fail, magic must lose, nothing arcane can face the ooze...", "_t")
t("Oozemancers separate themselves from normal civilisation so that they be more in harmony with Nature. Arcane force are reviled by them, and their natural attunement to the wilds lets them do battle with abusive magic-users on an equal footing.", "Oozemancers separate themselves from normal civilisation so that they be more in harmony with Nature. Arcane force are reviled by them, and their natural attunement to the wilds lets them do battle with abusive magic-users on an equal footing.", "_t")
t("They can spawn oozes to protect and attack from a distance while also being adept at harnessing the power of mindstars and psiblades.", "They can spawn oozes to protect and attack from a distance while also being adept at harnessing the power of mindstars and psiblades.", "_t")
t("#LIGHT_BLUE# * +0 Strength, +0 Dexterity, +0 Constitution", "#LIGHT_BLUE# * +0 Strength, +0 Dexterity, +0 Constitution", "_t")
t("#LIGHT_BLUE# * +0 Magic, +5 Willpower, +4 Cunning", "#LIGHT_BLUE# * +0 Magic, +5 Willpower, +4 Cunning", "_t")
t("#GOLD#Life per level:#LIGHT_BLUE# -3", "#GOLD#Life per level:#LIGHT_BLUE# -3", "_t")
t("Stone Warden", "Stone Warden", "birth descriptor name")
t("Stone Wardens are dwarves trained in both the eldritch arts and the worship of nature.", "Stone Wardens are dwarves trained in both the eldritch arts and the worship of nature.", "_t")
t("While other races are stuck in their belief that arcane forces and natural forces are meant to oppose, dwarves have found a way to combine them in harmony.", "While other races are stuck in their belief that arcane forces and natural forces are meant to oppose, dwarves have found a way to combine them in harmony.", "_t")
t("Stone Wardens are armoured fighters, dual wielding shields to channel many of their powers.", "Stone Wardens are armoured fighters, dual wielding shields to channel many of their powers.", "_t")
t("Their most important stats are: Strength, Magic and Willpower", "Their most important stats are: Strength, Magic and Willpower", "_t")
t("#LIGHT_BLUE# * +2 Strength, +0 Dexterity, +0 Constitution", "#LIGHT_BLUE# * +2 Strength, +0 Dexterity, +0 Constitution", "_t")
t("#LIGHT_BLUE# * +4 Magic, +3 Willpower, +0 Cunning", "#LIGHT_BLUE# * +4 Magic, +3 Willpower, +0 Cunning", "_t")
--]==]

------------------------------------------------
section "mod-tome/data/birth/descriptors.lua"


-- new text
--[==[
t("base", "base", "birth descriptor name")
t("Tutorial", "Tutorial", "birth descriptor name")
t("#GOLD##{bold}#Tutorial mode", "#GOLD##{bold}#Tutorial mode", "_t")
t("#WHITE#Start with a simplified character and discover the game in a simple quest.#{normal}#", "#WHITE#Start with a simplified character and discover the game in a simple quest.#{normal}#", "_t")
t("All damage done to the player reduced by 20%", "All damage done to the player reduced by 20%", "_t")
t("All healing for the player increased by 10%", "All healing for the player increased by 10%", "_t")
t("No main game achievements possible.", "No main game achievements possible.", "_t")
t("Easier", "Easier", "birth descriptor name")
t("#GOLD##{bold}#Easier mode#WHITE##{normal}#", "#GOLD##{bold}#Easier mode#WHITE##{normal}#", "_t")
t("Provides an easier game experience.", "Provides an easier game experience.", "_t")
t("Use it if you feel uneasy tackling the harder modes.", "Use it if you feel uneasy tackling the harder modes.", "_t")
t("All damage done to the player decreased by 30%", "All damage done to the player decreased by 30%", "_t")
t("All healing for the player increased by 30%", "All healing for the player increased by 30%", "_t")
t("All detrimental status effects durations reduced by 50%", "All detrimental status effects durations reduced by 50%", "_t")
t("Achievements are not granted.", "Achievements are not granted.", "_t")
t("Normal", "Normal", "birth descriptor name")
t("#GOLD##{bold}#Normal mode#WHITE##{normal}#", "#GOLD##{bold}#Normal mode#WHITE##{normal}#", "_t")
t("Provides the normal level of challenges.", "Provides the normal level of challenges.", "_t")
t("Stairs can not be used for 2 turns after a kill.", "Stairs can not be used for 2 turns after a kill.", "_t")
t("Nightmare", "Nightmare", "birth descriptor name")
t("#GOLD##{bold}#Nightmare mode#WHITE##{normal}#", "#GOLD##{bold}#Nightmare mode#WHITE##{normal}#", "_t")
t("Unfair game setting", "Unfair game setting", "_t")
t("All zone levels increased by 25% by the time Player reaches level 10", "All zone levels increased by 25% by the time Player reaches level 10", "_t")
t("All creature talent levels increased by 30%", "All creature talent levels increased by 30%", "_t")
t("Unique (fixed) bosses advance in bonus classes 30% faster", "Unique (fixed) bosses advance in bonus classes 30% faster", "_t")
t("Rare creatures are slightly more frequent", "Rare creatures are slightly more frequent", "_t")
t("Stairs can not be used for 3 turns after a kill.", "Stairs can not be used for 3 turns after a kill.", "_t")
t("Player can earn Nightmare version of achievements if also playing in Roguelike or Adventure permadeath mode.", "Player can earn Nightmare version of achievements if also playing in Roguelike or Adventure permadeath mode.", "_t")
t("Insane", "Insane", "birth descriptor name")
t("Easy is for the weak! Normal is for the weak! Nightmare is too easy! Bring on the true pain!", "Easy is for the weak! Normal is for the weak! Nightmare is too easy! Bring on the true pain!", "_t")
t("#GOLD##{bold}#Insane mode#WHITE##{normal}#", "#GOLD##{bold}#Insane mode#WHITE##{normal}#", "_t")
t("Similar rules to Nightmare, but with more random bosses!", "Similar rules to Nightmare, but with more random bosses!", "_t")
t("All zone levels increased by 50% + 1 by the time Player reaches level 10", "All zone levels increased by 50% + 1 by the time Player reaches level 10", "_t")
t("All creature talent levels increased by 70%", "All creature talent levels increased by 70%", "_t")
t("Unique (fixed) bosses advance in bonus classes 70% faster", "Unique (fixed) bosses advance in bonus classes 70% faster", "_t")
t("Rare creatures are far more frequent and random bosses start to appear", "Rare creatures are far more frequent and random bosses start to appear", "_t")
t("Stairs can not be used for 5 turns after a kill.", "Stairs can not be used for 5 turns after a kill.", "_t")
t("Player can earn Insane version of achievements if also playing in Roguelike or Adventure permadeath mode.", "Player can earn Insane version of achievements if also playing in Roguelike or Adventure permadeath mode.", "_t")
t("Madness", "Madness", "birth descriptor name")
t("Insane is for the weak! Bring on the true mind-shattering experience!", "Insane is for the weak! Bring on the true mind-shattering experience!", "_t")
t("#GOLD##{bold}#Madness mode#WHITE##{normal}#", "#GOLD##{bold}#Madness mode#WHITE##{normal}#", "_t")
t("Absolutely unfair game setting. Prepare for the full wrath of DarkGod!", "Absolutely unfair game setting. Prepare for the full wrath of DarkGod!", "_t")
t("All zone levels increased by 150% + 2 by the time Player reaches level 10", "All zone levels increased by 150% + 2 by the time Player reaches level 10", "_t")
t("All creature talent levels increased by 170%", "All creature talent levels increased by 170%", "_t")
t("Unique (fixed) bosses advance in bonus classes 170% faster", "Unique (fixed) bosses advance in bonus classes 170% faster", "_t")
t("All enemies have 200% more life", "All enemies have 200% more life", "_t")
t("Stairs can not be used for 9 turns after a kill.", "Stairs can not be used for 9 turns after a kill.", "_t")
t("Player starts with 100 more life and 500 gold, but trust us, you'll need it!", "Player starts with 100 more life and 500 gold, but trust us, you'll need it!", "_t")
t("Player is being hunted! Randomly all foes in a radius will get a feeling of where she/he is", "Player is being hunted! Randomly all foes in a radius will get a feeling of where she/he is", "_t")
t("Player can earn Madness version of achievements if also playing in Roguelike or Adventure permadeath mode.", "Player can earn Madness version of achievements if also playing in Roguelike or Adventure permadeath mode.", "_t")
t("Exploration", "Exploration", "birth descriptor name")
t("Exploration mode: Infinite lives (donator feature)", "Exploration mode: Infinite lives (donator feature)", "_t")
t("#GOLD##{bold}#Exploration mode#WHITE#", "#GOLD##{bold}#Exploration mode#WHITE#", "_t")
t("Provides you with infinite lives.#{normal}#", "Provides you with infinite lives.#{normal}#", "_t")
t("This is not the way the game is meant to be played, but it allows you to have a more forgiving experience.", "This is not the way the game is meant to be played, but it allows you to have a more forgiving experience.", "_t")
t("Remember though that dying is an integral part of the game and helps you become a better player.", "Remember though that dying is an integral part of the game and helps you become a better player.", "_t")
t("Exploration version of achievements will be granted in this mode.", "Exploration version of achievements will be granted in this mode.", "_t")
t("Full talent respec is always available.", "Full talent respec is always available.", "_t")
t("Adventure", "Adventure", "birth descriptor name")
t("#GOLD##{bold}#Adventure mode#WHITE#", "#GOLD##{bold}#Adventure mode#WHITE#", "_t")
t("Provides you with limited extra lives.", "Provides you with limited extra lives.", "_t")
t("Use it if you want normal playing conditions but do not feel ready for just one life.#{normal}#", "Use it if you want normal playing conditions but do not feel ready for just one life.#{normal}#", "_t")
t("At level 1,2,5,7,14,24,35 get one more 'life' that allows you to resurrect at the start of the level.", "At level 1,2,5,7,14,24,35 get one more 'life' that allows you to resurrect at the start of the level.", "_t")
t("Roguelike", "Roguelike", "birth descriptor name")
t("#GOLD##{bold}#Roguelike mode#WHITE#", "#GOLD##{bold}#Roguelike mode#WHITE#", "_t")
t("Provides the closer experience to 'classic' roguelike games.", "Provides the closer experience to 'classic' roguelike games.", "_t")
t("You will only have one life; you *ARE* your character.#{normal}#", "You will only have one life; you *ARE* your character.#{normal}#", "_t")
t("Only one life, unless ways to self-resurrect are found in-game.", "Only one life, unless ways to self-resurrect are found in-game.", "_t")
--]==]

