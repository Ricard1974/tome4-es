-- section "mod-tome/data/talents/corruptions/curses.lua"

-- new text
t("Curse of Defenselessness", "Maldicion of Defenselessness", "talent name")
t("Curse of Impotence", "Maldicion of Impotence", "talent name")
t("Curse of Death", "Maldicion of Muerte", "talent name")
t("Curse of Vulnerability", "Maldicion of Vulnerability", "talent name")
t("Curses your target, decreasing its Defense and all saves by %d for 5 turns.  This cannot be saved against.\n\t\tThe effects will improve with your Spellpower.", "Cursa tu objetivo, disminuyendo su Defensa y todo ahorra por %d por 5 vueltas. Esto no puedes salvarse.\nLos efectos mejorarán con tu poder de pago.", "tformat")
t("Curses your target, decreasing all damage it does by %d%% for 10 turns.\n\t\tThe effects will improve with your Spellpower.", "Cursa tu objetivo, disminuyendo todo el daño que haces por %d %% por 10 vueltas.\nLos efectos mejorarán con tu poder de pago.", "tformat")
t("Curses your target, preventing normal life regeneration and dealing %0.2f darkness damage over 10 turns.\n\t\tThe damage will increase with your Spellpower.", "Cursa tu objetivo, previniendo la regeneración normal de la vida y tratando daño de las tinieblas de %0.2f sobre 10 vueltas.\nEl daño aumentará con tu poder de pago.", "tformat")
t("Curses your target, decreasing all its resistances by %d%% for 7 turns.\n\t\tThe effect will improve with your Spellpower.", "Corta tu objetivo, disminuyendo todas sus resistencias por %d %% para 7 turnos.\nEl efecto mejorará con tu poder de expresión.", "tformat")
t("Curses your target, decreasing its Defense and all saves by %d for 5 turns.  This cannot be saved against.\n\t\tThe effects will improve with your Spellpower.", "Cursa tu objetivo, disminuyendo su Defensa y todo ahorra por %d por 5 vueltas. Esto no puedes salvarse.\nLos efectos mejorarán con tu poder de pago.", "tformat")
t("Curses your target, decreasing all damage it does by %d%% for 10 turns.\n\t\tThe effects will improve with your Spellpower.", "Cursa tu objetivo, disminuyendo todo el daño que haces por %d %% por 10 vueltas.\nLos efectos mejorarán con tu poder de pago.", "tformat")
t("Curses your target, preventing normal life regeneration and dealing %0.2f darkness damage over 10 turns.\n\t\tThe damage will increase with your Spellpower.", "Cursa tu objetivo, previniendo la regeneración normal de la vida y tratando daño de las tinieblas de %0.2f sobre 10 vueltas.\nEl daño aumentará con tu poder de pago.", "tformat")
t("Curses your target, decreasing all its resistances by %d%% for 7 turns.\n\t\tThe effect will improve with your Spellpower.", "Corta tu objetivo, disminuyendo todas sus resistencias por %d %% para 7 turnos.\nEl efecto mejorará con tu poder de expresión.", "tformat")
t("Curses your target, decreasing its Defense and all saves by %d for 5 turns.  This cannot be saved against.\n\t\tThe effects will improve with your Spellpower.", "Cursa tu objetivo, disminuyendo su Defensa y todo ahorra por %d por 5 vueltas. Esto no puedes salvarse.\nLos efectos mejorarán con tu poder de pago.", "tformat")
t("Curses your target, decreasing all damage it does by %d%% for 10 turns.\n\t\tThe effects will improve with your Spellpower.", "Cursa tu objetivo, disminuyendo todo el daño que haces por %d %% por 10 vueltas.\nLos efectos mejorarán con tu poder de pago.", "tformat")
t("Curses your target, preventing normal life regeneration and dealing %0.2f darkness damage over 10 turns.\n\t\tThe damage will increase with your Spellpower.", "Cursa tu objetivo, previniendo la regeneración normal de la vida y tratando daño de las tinieblas de %0.2f sobre 10 vueltas.\nEl daño aumentará con tu poder de pago.", "tformat")
