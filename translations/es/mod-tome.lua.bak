-- section "mod-tome/data/general/objects/boss-artifacts-maj-eyal.lua"

-- new text
t("Wintertide", "Wintertide", "entity name")
t("glittering longsword", "espada larga brillante", "_t")
t("No Winter Storm Active", "No Winter Storm Active", "_t")
t("Winter Storm: ", "Tormenta de Invierno:", "_t")
t("radius %d (%d turns remaining)", "radius %d ( %d vueltas restantes)", "tformat")
t("None", "Ninguno", "_t")
t("Create a Winter Storm that gradually expands (from radius %d to radius %d), dealing %0.2f cold damage (based on Strength) to your enemies each turn and slowing their ability to act by 20%%.  Subsequent melee strikes will relocate the storm on top of your target and increase its duration.", "Crear una tormenta de invierno que se expande gradualmente (desde el radio %d a radio %d ), tratando %0.2f daño frío (basado en la fuerza) a tus enemigos cada turno y ralentizando tu capacidad de actuar en un 20%%. Las posteriores huelgas de cuerpo a cuerpo reubicarán la tormenta encima de tu objetivo y aumentarán tu duración.", "tformat")
t("#LIGHT_BLUE#A Winter Storm forms around %s.", "#LIGHT_BLUE#A Winter Storm se forma alrededor %s.", "logSeen")
t("precipitate ice walls (lasting 10 turns) within your Winter Storm's area", "precipitar paredes de hielo (durante 10 vueltas) dentro de la zona de la tormenta de invierno", "_t")
t("#LIGHT_BLUE#%s brandishes %s %s, releasing a wave of Winter cold!", "#LIGHT_BLUE#!%s%s%s", "logSeen")
t("winter wall", "muro de invierno", "_t")
t("a summoned wall of ice", "un muro de hielo convocado", "_t")
t("#LIGHT_BLUE#Ice and snow form a barrier!", "¡El hielo y la nieve forman una barrera!", "log")
t("Wintertide Phial", "Wintertide Phial", "entity name")
t("phial filled with darkness", "phial lleno de oscuridad", "_t")
t("This phial seems filled with darkness, yet it cleanses your thoughts.", "Este phial parece lleno de oscuridad, pero limpia tus pensamientos.", "_t")
t("cleanse your mind of up to %d (based on Magic) detrimental mental effects", "limpiar tu mente de hasta %d (basado en Magic) efectos mentales perjudiciales", "tformat")
t("%s uses %s %s to cleanse %s mind!", "%s utiliza %s %s para limpiar %s ¡La mente!", "logSeen")
t("Frost Treads", "Frost Treads", "entity name")
t("ice-covered boots", "botas cubiertas de hielo", "_t")
t("A pair of leather boots. Cold to the touch, they radiate a cold blue light.", "Un par de botas de cuero. Fríos al tacto, irradian una luz azul fría.", "_t")
t("Each step taken casts a ground frost effect in a radius of 1 around you for 5 turns, giving you a 20% cold damage bonus for 3 turns. Additionally, any enemy standing in the frost has a 20% chance of talent failure for 3 turns.", "Cada paso realizado arroja un efecto de helada de tierra en un radio de 1 alrededor de tú por 5 vueltas, dándole un 20% de bono de daño frío por 3 vueltas. Además, cualquier enemigo de pie en la helada tienes un 20% de probabilidad de fracaso de talento para 3 vueltas.", "_t")
t("Dragonskull Helm", "Dragonskull Helm", "entity name")
t("skull helm", "craneal", "_t")
t("Traces of a dragon's power still remain in this bleached and cracked skull.", "Los rastros del poder de un dragón todavía permanecen en este cráneo blanqueado y agrietado.", "_t")
t("Eel-skin armour", "Armadura de piel de anguila", "entity name")
t("slippery armour", "armadura resbaladiza", "_t")
t("This armour seems to have been patched together from many eels. Yuck.", "Esta armadura parece haber sido reparada juntos desde muchos anguilas. Maldición.", "_t")
t("Nightsong", "Nightsong", "entity name")
t("A pitch black ring, unadorned. It seems as though tendrils of darkness creep upon it.", "Un anillo negro de lanzamiento, no adorado. Parece que los zarcillos de la oscuridad se arrastran sobre ella.", "_t")
t("obsidian ring", "anillo obsidiario", "_t")
t("Steel Helm of Garkul", "Helm de acero de Garkul", "entity name")
t("tribal helm", "tribal yelmo", "_t")
t("A great helm that belonged to Garkul the Devourer, one of the greatest orcs ever to live.", "Un gran timón que perteneció a Garkul el Devourer, uno de los mayores orcos para vivir.", "_t")
t("Another of Garkul's heirlooms would bring out his spirit.", "Otro de los herederos de Garkul sacaría tu espíritu.", "_t")
t("Lunar Shield", "Lunar Escudo", "entity name")
t("chitinous shield", "escudo elegante", "_t")
t("A large section of chitin removed from Nimisil. It continues to give off a strange white glow.", "Una gran sección de chitín eliminado de Nimisil. Sigue dando un extraño resplandor blanco.", "_t")
t("Wrathroot's Barkwood", "Barkwood de Wrathroot", "entity name")
t("large chunk of wood", "gran trozo de madera", "_t")
t("The barkwood of Wrathroot, made into roughly the shape of a shield.", "La madera de corteza de Wrathroot, se convirtió en aproximadamente la forma de un escudo.", "_t")
t("Petrified Wood", "Madera petrificada", "entity name")
t("red", "rojo", "entity subtype")
t("burned piece of wood", "pedazo quemado de madera", "_t")
t("A piece of the scorched wood taken from the remains of Snaproot.", "Un pedazo de madera asada tomada de los restos de Snaproot.", "_t")
t("Crystal Shard", "Cristal Shard", "entity name")
t("crystalline tree branch", "rama cristalina del árbol", "_t")
t("This crystalline tree branch is remarkably rigid, and refracts light in myriad colors. Gazing at it entrances you, and you worry where its power may have come from.", "Esta rama cristalina del árbol es notablemente rígida, y refracta la luz en los colores de miriad. Atraparte en ella te entra, y te preocupas de dónde puedes haber venido tu poder.", "_t")
t("create 2 living shards of crystal to serve you for 10 turns", "crear 2 fragmentos vivos de cristal para servirle durante 10 vueltas", "_t")
t("You cannot summon; you are suppressed!", "¡No puedes convocar; estás suprimido!", "logPlayer")
t("Crystals splinter off of %s's %s and animate!", "¡Los cristales saltan de %s 's %s y animan!", "logSeen")
t("Malediction", "Malediction", "entity name")
t("pestilent waraxe", "pestilente hacha de guerra", "_t")
t("The land withers and crumbles wherever this cursed axe rests.", "La tierra se marchita y desmorona dondequiera que este hacha maldito descansa.", "_t")
t("Kor's Fall", "Kor's Fall", "entity name")
t("dark staff", "personal oscuro", "_t")
t("Made from the bones of many creatures, this staff glows with power. You can feel its evil presence even from a distance.", "Hecho de los huesos de muchas criaturas, este personal brilla con poder. Tú puedes sentir tu presencia malvada incluso desde una distancia.", "_t")
t("Vox", "Vox", "entity name")
t("ringing amulet", "anillo amuleto", "_t")
t("No force can hope to silence the wearer of this amulet.", "Ninguna fuerza puedes esperar silenciar al portador de este amuleto.", "_t")
t("Telos's Staff (Top Half)", "Telos's Staff (Top Half)", "entity name")
t("broken staff", "personal roto", "_t")
t("The top part of Telos' broken staff.", "La parte superior del personal roto de Telos.", "_t")
t("Choker of Dread", "Choker of Dread", "entity name")
t("dark amulet", "amuleto oscuro", "_t")
t("The evilness of undeath radiates from this amulet.", "La maldad de la muerte irradia de este amuleto.", "_t")
t("summon an elder vampire with Taunt to your side for 15 turns", "convocar a un vampiro mayor con Taunt a tu lado durante 15 vueltas", "_t")
t("You need an enemy nearby to summon!", "¡Necesitas un enemigo cercano para convocar!", "logPlayer")
t("Not enough space to summon!", "¡No hay suficiente espacio para convocar!", "logPlayer")
t("%s taps %s %s, summoning a vampire thrall!", "%s, convocando a un vampiro thrall!%s%s", "logSeen")
t("elder vampire", "el viejo vampiro", "_t")
t("A terrible robed undead figure, this creature has existed in its unlife for many centuries by stealing the life of others. It can summon the very shades of its victims from beyond the grave to come enslaved to its aid.", "Una terrible figura no muerta robada, esta criatura ha existido en tu vida durante muchos siglos robando la vida de otros. Puede convocar a los mismos tonos de sus víctimas desde más allá de la tumba para llegar esclavizada a tu ayuda.", "_t")
t("Vampire", "Vampiro", "_t")
t("gem", "gema", "entity type")
t("Runed Skull", "Runed Skull", "entity name")
t("human skull", "cráneo humano", "_t")
t("Dull red runes are etched all over this blackened skull.", "Corridas rojas aburridas están grabadas por todo este cráneo ennegrecido.", "_t")
t("Bill's Tree Trunk", "El truco del árbol de Bill", "entity name")
t("tree trunk", "árbol tronco", "_t")
t("This is a big, nasty-looking tree trunk that Bill the Troll used as a weapon. It could still serve this purpose, should you be strong enough to wield it!", "Este eres un tronco de árbol grande y desagradable que Bill el Troll utilizó como arma. Todavía podría servir este propósito, si tú es lo suficientemente fuerte para manejarlo!", "_t")
t("Sanguine Shield", "Sanguine Escudo", "entity name")
t("bloody shield", "escudo de sangre", "_t")
t("Though tarnished and spattered with blood, the emblem of the Sun still manages to shine through on this shield.", "Aunque empañado y esparcido con sangre, el emblema del Sol todavía logra brillar en este escudo.", "_t")
t("Flamewrought", "Flamewrought", "entity name")
t("chitinous gloves", "guantes chitinosos", "_t")
t("These gloves seems to be made out of the exoskeletons of ritches. They are hot to the touch.", "Estos guantes parecen estar hechos de los exoesqueletos de ritos. Están calientes al tacto.", "_t")
t("Crystal Focus", "Crystal Enfoque", "entity name")
t("multi-hued", "multihued", "entity subtype")
t("scintillating crystal", "cristales centelleantes", "_t")
t("This crystal radiates the power of the Spellblaze itself.", "Este cristal irradia el poder del Spellblaze mismo.", "_t")
t("(The created item can be activated to recover the Focus.)", "(El elemento creado se puede activar para recuperar el Focus.)", "_t")
t("combine with a weapon (makes a non enchanted weapon into an artifact)", "combinar con un arma (haces un arma no encantada en un artefacto)", "_t")
t("Fuse with which weapon?", "¿Con qué arma?", "_t")
t("crystalline weapon", "arma cristalina", "_t")
t("#GOLD#As the crystalline weapon and armour are brought together, they begin to emit a constant humming.", "#GOLD#A medida que el arma cristalina y la armadura se juntan, comienzan a emitir un constante abrazo.", "logPlayer")
t("#GOLD#The humming from the crystalline artifacts fades as they are separated.", "#GOLD#El recorte de los artefactos cristalinos se desvanece mientras están separados.", "logPlayer")
t("Crystalline %s", "Crystalline %s", "tformat")
t(" Transformed with the power of the Spellblaze.", "Transformado con el poder del Spellblaze.", "_t")
t("recover the Crystal Focus (destroys this weapon)", "recuperar el foco de cristal (destruye este arma)", "_t")
t("You created: %s", "Tú creó: %s", "logPlayer")
t("You fix the crystal on the %s and create the %s.", "Arregla el cristal en el %s y creas el %s.", "logPlayer")
t("Crystal Heart", "Corazón de cristal", "entity name")
t("coruscating crystal", "cristal de coruscación", "_t")
t("This crystal is huge, easily the size of your head. It sparkles brilliantly almost of its own accord.", "Este cristal es enorme, fácilmente el tamaño de tu cabeza. Brillantemente casi por tu propio acuerdo.", "_t")
t("(The created item can be activated to recover the Heart.)", "(El elemento creado se puede activar para recuperar el Corazón.)", "_t")
t("combine with a suit of body armor (makes a non enchanted armour into an artifact)", "combinar con un traje de armadura corporal (haces una armadura no encantada en un artefacto)", "_t")
t("Fuse with which armor?", "¿Con qué armadura?", "_t")
t("crystalline armour", "armadura cristalina", "_t")
t("recover the Crystal Heart (destroys this armour)", "recuperar el Corazón de Cristal (destruye esta armadura)", "_t")
t("Rod of Annulment", "Rod of Annulment", "entity name")
t("dark rod", "barra oscura", "_t")
t("You can feel magic draining out around this rod. Even nature itself seems affected.", "Puedes sentir magia drenando alrededor de esta vara. Incluso la naturaleza misma parece afectada.", "_t")
t("put up to 3 of the target's runes, infusions or talents on cooldown for 3-5 turns (range %d)", "poner hasta 3 de las runas del objetivo, infusiones o talentos en refrigeración por 3-5 vueltas (range %d )", "tformat")
t("#Source# aims %s %s at #target#!", "#Source# aims %s %s at #target#!", "logCombat")
t("%s's %s is disrupted!", "%s estás interrumpido!%s", "logSeen")
t("Skullcleaver", "Skullcleaver", "entity name")
t("crimson waraxe", "carmesí hacha de guerra", "_t")
t("A small but sharp axe, with a handle made of polished bone.  The blade has chopped through the skulls of many, and has been stained a deep crimson.", "Un hacha pequeña pero afilada, con un mango hecho de hueso pulido. La espada ha picado a través de los cráneos de muchos, y ha sido manchado un profundo carmesí.", "_t")
t("Tooth of the Mouth", "Diente del Mouth", "entity name")
t("a tooth", "un diente", "_t")
t("A huge tooth taken from the Mouth, in the Deep Bellow.", "Un diente enorme tomado del Mouth, en el Deep Bellow.", "_t")
t("The Warped Boots", "Las Botas Warped", "entity name")
t("pair of painful-looking boots", "par de botas de aspecto doloroso", "_t")
t("These blackened boots have lost all vestiges of any former glory they might have had. Now, they are a testament to the corruption of the Deep Bellow, and its power.", "Estas botas ennegrecidas han perdido todos los vestigios de cualquier antigua gloria que pudieran haber tenido. Ahora, ellos son un testamento a la corrupción del Huevo Profundo, y tu poder.", "_t")
t("Withering Orbs", "Orbes que se marchitan", "entity name")
t("shadow-strung orbs", "orbes de sombra", "_t")
t("Borfast's Cage", "La jaula de Borfast", "entity name")
t("a suit of pitted and pocked plate-mail", "un traje de chapa perforada", "_t")
t("Aletta's Diadem", "Diadem de Aletta", "entity name")
t("jeweled diadem", "diadem joyas", "_t")
t("Hare-Skin Sling", "Sling Hare-Skin", "entity name")
t("hare-skin sling", "sling hare-skin", "_t")
t("Prox's Lucky Halfling Foot", "Prox's Lucky Mediano Foot", "entity name")
t("a mummified halfling foot", "un pie medio momificado", "_t")
t(" (cooling down: %d turns)", "(golpeando hacia abajo: %d vueltas)", "tformat")
t("", "", "_t")
t("#CRIMSON#%s twitches, alerting %s that a hidden trap is nearby.", "#CRIMSON#.%s%s", "logSeen")
t("%s shrugs off some effects!", "%s ¡Apaga algunos efectos!", "logSeen")
t("#LIGHT_RED#You feel uneasy carrying %s.", "#LIGHT RED # You feel uneasy carrying %s.", "logPlayer")
t("Psionic Fury", "Psionic Furia", "entity name")
t("vibrating mindstar", "estrella de mente vibradora", "_t")
t("This mindstar constantly shakes and vibrates, as if a powerful force is desperately trying to escape.", "Esta estrella mental constantemente sacude y vibra, como si una fuerza poderosa estuviera tratando desesperadamente de escapar.", "_t")
t("release a wave of psionic power, dealing %0.2f mind damage (based on Willpower) to all within radius %d", "lanzar una ola de poder psionico, tratando %0.2f daño mental (basado en Willpower) a todos dentro del radio %d", "tformat")
t("%s's %s sends out a blast of psionic energy!", "%s 's %s envía una explosión de energía psionica!", "logSeen")
t("Storm Bringer's Gauntlets", "Tormenta Bringer's Gauntlets", "entity name")
t("fine-mesh gauntlets", "guantes de malla fina", "_t")
t("This pair of fine mesh voratun gauntlets is covered with glyphs of power that spark with azure energy.  The metal is supple and light so as not to interfere with spell-casting.  When and where these gauntlets were forged is a mystery, but odds are the crafter knew a thing or two about magic.", "Este par de gauntlets de malla fina estás cubierto con glifos de poder que chispa con energía azul. El metal es flexible y ligero para no interferir con la radiografía de hechizos. Cuando y donde se forjaron estos guantes eres un misterio, pero las probabilidades son que el artesano sabía una o dos cosas sobre la magia.", "_t")
t("+1 to all lightning damage spells", "+1 a todos los hechizos de daños relámpagos", "_t")
t("River's Fury", "River's Furia", "entity name")
t("ornate trident", "ornado tridente", "_t")
t("This gorgeous and ornate trident was wielded by Lady Nashva, and when you hold it, you can faintly hear the roar of a rushing river.", "Este magnífico y ordenado tridente fue marchitado por Lady Nashva, y cuando lo sostienes, puedes escuchar débilmente el rugido de un río precipitado.", "_t")
t("Unerring Scalpel", "Unerring Scalpel", "entity name")
t("long sharp scalpel", "largo escalpelo agudo", "_t")
t("This scalpel was used by the dread sorcerer Kor'Pul when he began learning the necromantic arts in the Age of Dusk.  Many were the bodies, living and dead, that became unwilling victims of his terrible experiments.", "Este escalpelo fue utilizado por el temido hechicero Kor'Pul cuando comenzó a aprender las artes necrométicas en la Era del Dusk. Muchos eran los cuerpos, vivos y muertos, que se convirtieron en víctimas de sus terribles experimentos.", "_t")
t("Wyrmbreath", "Wyrmbreath", "entity name")
t("clawed dragon-scale gloves", "guantes a escala de dragón", "_t")
t("These dragon scale gloves are tipped with the claws and teeth of a vicious Wyrm. The gloves are warm to the touch.", "Estos guantes de escamas de dragón están llenos de garras y dientes de un Wyrm vicioso. Los guantes están calientes al tacto.", "_t")
t("Eye of the Dreaming One", "Ojo del Sueño", "entity name")
t("translucent sphere", "esfera translúcida", "_t")
t("This ethereal eye stares eternally, as if seeing things that do not truly exist.", "Este ojo etéreo mira eternamente, como si viera cosas que no existen realmente.", "_t")

