------------------------------------------------
-- section "mod-tome/data/general/npcs/ghost.lua"

-- new text
t("undead", "no-muerto", "entity type")
t("ghost", "fantasma", "entity subtype")
t("dread", "♪", "entity name")
t("It is a form that screams its presence against the eye. Death incarnate, its hideous black body seems to struggle against reality as the universe itself strives to banish it.", "Es una forma que grita tu presencia contra el ojo. La muerte encarnada, tu horrible cuerpo negro parece luchar contra la realidad mientras el universo mismo se esfuerza por desterrarla.", "_t")
t("dreadmaster", "temblor", "entity name")
t("It is an unlife of power almost unequaled. An affront to existence, its very touch abuses and disrupts the flow of life, and its unearthly limbs, of purest black, crumble rock and wither flesh with ease.", "Es una vida de poder casi desigual. Una afrenta a la existencia, sus propios abusos y perturba el flujo de la vida, y sus extremidades descaradamente, de la roca más pura, desmoronada y la carne marchitada con facilidad.", "_t")
t("banshee", "banshee", "entity name")
t("It is a ghostly woman's form that wails mournfully.", "Es la forma de una mujer fantasmal que se lamenta.", "_t")
t("ruin banshee", "ruina banshee", "entity name")
t("A vengeful, screaming soul given form with the breath of Urh'Rok himself. The vapors of the Fearscape seep from its dimension-bending form, withering and searing.", "Un alma vengativa, gritando, dada forma con el aliento del propio Urh'Rok. Los vapores del Teopacio seep de tu forma de curvatura de dimensión, marchitando y sellando.", "_t")

