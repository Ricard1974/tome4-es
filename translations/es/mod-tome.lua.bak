-- section "mod-tome/data/birth/races/giant.lua"

-- new text
t("Giant", "Gigante", "birth descriptor name")
t("Powerful beings that tower over all, but the bigger they are, the harder they fall...", "Poderosos seres que se elevan sobre todos, pero cuanto más grandes son, más duros se caen...", "_t")
t("Skin", "Piel", "birth facial category")
t("Hairs", "Pelo", "birth facial category")
t("Facial features", "Rasgos faciales", "birth facial category")
t("Tatoos", "Tatoos", "birth facial category")
t("Special", "Especial", "birth facial category")
t("Ogre", "Ogro", "birth descriptor name")
t("Ogres are an altered form of Human, created in the Age of Allure as workers and warriors for the Conclave.", "Los ogros son una forma alterada de Humano, creada en la Era de Alejamiento como obreros y guerreros para el cónclave.", "_t")
t("Inscriptions have granted them magical and physical power far beyond their natural limits, but their dependence on runic magic made them a favored target during the Spellhunt, forcing them to take refuge among the Shalore.", "Las inscripciones les han concedido un poder mágico y físico mucho más allá de sus límites naturales, pero tu dependencia de la magia escénica les hizo un objetivo favorecido durante el Spellhunt, obligándolos a refugiarse entre el Shalore.", "_t")
t("Their preference for simple and direct solutions has given them an undeserved reputation as dumb brutes, despite their extraordinary talent with runes and their humble, dutiful nature.", "Tu preferencia por soluciones simples y directas les ha dado una reputación no merecida como brutos tontos, a pesar de tu extraordinario talento con runas y tu naturaleza humilde y dudosa.", "_t")
t("They possess the #GOLD#Ogric Wrath#WHITE# talent, which grants them critical chance and power, as well as resistance to confusion and stuns, when their attacks miss or are blocked.", "Poseen el talento #GOLD#Ogric Wrath#WHITE#, que les otorgas oportunidades y poder críticos, así como la resistencia a la confusión y aturdimientos, cuando sus ataques se pierden o se bloquean.", "_t")
t("#GOLD#Stat modifiers:", "#GOLD#Modificadores de atributos:", "_t")
t("#LIGHT_BLUE# * +3 Strength, -1 Dexterity, +0 Constitution", "#LIGHT_BLUE# * +3 Strength, -1 Dexterity, +0 Constitution", "_t")
t("#LIGHT_BLUE# * +2 Magic, -2 Willpower, +2 Cunning", "#LIGHT_BLUE# * +2 Magic, -2 Willpower, +2 Cunning", "_t")
