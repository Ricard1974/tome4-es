section "mod-tome/data/chats/slasul.lua"


-- new text
--[==[
t("[attack]", "[attack]", "_t")
t("So be it... Die now!", "So be it... Die now!", "_t")
t("I was sent by Ukllmswwik to stop your mad schemes to control all underwater life!", "I was sent by Ukllmswwik to stop your mad schemes to control all underwater life!", "_t")
t("Your feeble attempt to sway me from the side of good will not work. Pay for you sins!", "Your feeble attempt to sway me from the side of good will not work. Pay for you sins!", "_t")
t("If you refuse to see reason, you leave me no choice!", "If you refuse to see reason, you leave me no choice!", "_t")
t("Your words are... disturbing. Why should I spare you?", "Your words are... disturbing. Why should I spare you?", "_t")
t("You do not sound mad to me... could Ukllmswwik have lied?", "You do not sound mad to me... could Ukllmswwik have lied?", "_t")
t("I will not be deceived by your lies! I will make your pay for your victims!", "I will not be deceived by your lies! I will make your pay for your victims!", "_t")
t("As you wish. It did not have to come to this...", "As you wish. It did not have to come to this...", "_t")
t("Use this portal. It will bring you back to his cave; ask him the truth.", "Use this portal. It will bring you back to his cave; ask him the truth.", "_t")
t("I will make him pay for his treachery.", "I will make him pay for his treachery.", "_t")
t("Thank you for listening to me.", "Thank you for listening to me.", "_t")
t("The dragon was lying, I can feel it. I have decided to embrace your cause.", "The dragon was lying, I can feel it. I have decided to embrace your cause.", "_t")
t("Farewell, Slasul.", "Farewell, Slasul.", "_t")
t("I shall accept your offer, my liege.", "I shall accept your offer, my liege.", "_t")
t("LET US BE BOUND!", "LET US BE BOUND!", "_t")
t("This sounds strange. I need to think about it.", "This sounds strange. I need to think about it.", "_t")
--]==]

