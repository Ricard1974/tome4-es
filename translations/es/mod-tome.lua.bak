-- new text
t("undead", "no-muerto", "entity type")
t("rodent", "roedor", "entity subtype")
t("skeletal rat", "rata esquelética", "entity name")
t("A skeletal rat, teeth and claws ground to a sharp point. It glares at you menacingly.", "Una rata esquelética, dientes y garras tierra a un punto agudo. Te llama amenazante.", "_t")
t("*squeak*", "*squeak*", "_t")
t("Squeak!", "¡Squeak!", "_t")
t("Squeak??", "¿Squeak?", "_t")
t("SQUEAK!!!!!", "¡SQUEAK!!", "_t")
t("ghoulish rat", "rata gruñida", "entity name")
t("Layers of rotting skin are peeling off of this rat. One of the eye sockets appears empty.", "Las capas de piel podrida están pelando de esta rata. Una de las tomas de ojos aparece vacía.", "_t")
t("*s.q.u.e.a.k*", "*s.q.u.e.a.k*", "_t")
t("Squeeeeeeak!", "¡Squeeeeeeak!", "_t")
t("Squeakkkkkkk??", "¿Squeakkkkkkk?", "_t")
t("spectral rat", "rata espectral", "entity name")
t("An eerie haze surrounds this translucent rat.", "Una lencería rodea a esta rata translúcida.", "_t")
t("Eerie Squeak!", "¡Eerie Squeak!", "_t")
t("Frightening Squeak??", "¿Squeak aterrador?", "_t")
t("vampire rat", "rata vampiro", "entity name")
t("Looks much like a normal rat. That is, other than the very large fangs.", "Parece una rata normal. Eso es, aparte de los colmillos muy grandes.", "_t")
t("Squeak! Blood!", "¡Squeak! ¡Sangre!", "_t")
t("gigantic bone rat", "rata ósea gigantesca", "entity name")
t("This massive beast appears to be a rat composed of countless bones fused together.", "Esta bestia masiva parece ser una rata compuesta de innumerables huesos fusionados.", "_t")
t("*SQUEAK*", "*SQUEAK*", "_t")
t("Rat Lich", "Rata Liche", "entity name")
t("The master of the pit is before you. It squeaks with menace as it and a horde of minions approach you.", "El maestro de la fosa estás ante ti. Se hunde con la amenaza mientras y una horda de secuaces se acercan a tú.", "_t")
t("#RED#Rising again, the Rat Lich's eyes glow with renewed energy!", "#RED#Rising again, the Rat Lich's eyes bright with renewed energy!", "logSeen")
t(" The Rat Lich's true power has been unveiled! Swirling with arcane energy, it stalks towards you uttering warsqueaks at its minions!", "¡El verdadero poder de Rat Lich ha sido revelado! Swirling con energía arcana, que acecha hacia tú pronunciando warsqueaks en sus secuaces!", "_t")

