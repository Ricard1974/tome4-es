------------------------------------------------
-- section "mod-tome/data/general/npcs/sandworm.lua"

-- new text
t("vermin", "alimaña", "entity type")
t("sandworm", "gusano de arena", "entity subtype")
t("sandworm", "gusano de arena", "entity name")
t("A huge worm coloured as the sand it inhabits. It seems quite unhappy about you being in its lair.", "Un enorme gusano coloreado como la arena que habita. Parece muy infeliz por estar en tu guarida.", "_t")
t("sandworm destroyer", "destructor de gusano de arena", "entity name")
t("A huge worm coloured as the sand it inhabits. This particular sandworm seems to have been bred for one purpose only: the eradication of everything that is non-sandworm, such as... you.", "Un enorme gusano coloreado como la arena que habita. Este gusano de arena en particular parece haber sido criado sólo para un propósito: la erradicación de todo lo que no eres el gusano, como... tú.", "_t")
t("sand-drake", "draco de arena", "entity name")
t("dragon", "dragón", "entity type")
t("sand", "arena", "entity subtype")
t("This unholy creature looks like a wingless dragon in shape, but it is sand-colored, making it all the more dangerous for its prey.", "Esta criatura impía se parece a un dragón sin alas en forma, pero es de color arena, lo que lo haces más peligroso para tu presa.", "_t")
t("gigantic sandworm tunneler", "gigantesca tormenta de arena", "entity name")
t("The ground shakes as this huge worm burrows towards you, its gigantic mouth just as capable of devouring flesh as stone.", "El suelo se sacude mientras este enorme gusano se hunde hacia ti, tu gigantesca boca tan capaz devorar la carne como la piedra.", "_t")
t("gigantic gravity worm", "gigantesco gusano de gravedad", "entity name")
t("Space and time seem to bend around this huge worm.", "El espacio y el tiempo parecen doblarse alrededor de este enorme gusano.", "_t")
t("gigantic corrosive tunneler", "gigantesco túnel corrosivo", "entity name")
t("This huge worm burrows through the earth using its powerful corrosive saliva.", "Este enorme gusano se hunde por la tierra usando tu poderosa saliva corrosiva.", "_t")
t("%s explodes in an acidic cloud.", "%s explota en una nube ácida.", "logSeen")

