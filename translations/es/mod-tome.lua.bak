section "mod-tome/data/birth/races/yeek.lua"


-- new text
--[==[
t("Skin", "Skin", "birth facial category")
t("Hairs", "Hairs", "birth facial category")
t("Facial features", "Facial features", "birth facial category")
t("Tatoos", "Tatoos", "birth facial category")
t("Special", "Special", "birth facial category")
t("Yeek", "Yeek", "birth descriptor name")
t("One race, one mind, one way. Our oppression shall end, and we shall inherit Eyal. Do not presume we are weak - our way is true, and only those who help us shall see our strength.", "One race, one mind, one way. Our oppression shall end, and we shall inherit Eyal. Do not presume we are weak - our way is true, and only those who help us shall see our strength.", "_t")
t("Yeeks are a mysterious race of small humanoids native to the tropical island of Rel.", "Yeeks are a mysterious race of small humanoids native to the tropical island of Rel.", "_t")
t("Their body is covered with white fur and their disproportionate heads give them a ridiculous look.", "Their body is covered with white fur and their disproportionate heads give them a ridiculous look.", "_t")
t("Although they are now nearly unheard of in Maj'Eyal, they spent many thousand years as secret slaves to the Halfling nation of Nargol.", "Although they are now nearly unheard of in Maj'Eyal, they spent many thousand years as secret slaves to the Halfling nation of Nargol.", "_t")
t("They gained their freedom during the Age of Pyre and have since then followed 'The Way' - a unity of minds enforced by their powerful psionics.", "They gained their freedom during the Age of Pyre and have since then followed 'The Way' - a unity of minds enforced by their powerful psionics.", "_t")
