t("%sClear bonus: %s%s%s! Score bonus: %s%s%s! Danger bonus: %s%s%s! Rank bonus: %s%s%s!", "%s Bono de puntuación: %s %s! Bonificación del peligro: %s Rank bonus: %s0 %s!%s%s%s%s%s%s%s", "log")
t("%sYour experience increases by %s%d%s!", "%s Tu experiencia aumentas por %s!%d%s", "log")
