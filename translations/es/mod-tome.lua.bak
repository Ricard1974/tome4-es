t("eradication", "erradicación", "talent type")
t("Doom to all your foes. Crush them.", "A todos tus enemigos. Crush them.", "_t")
t("necrosis", "necrosis", "talent type")
t("Gain control over death, by unnaturally expanding your life.", "Obtenga control sobre la muerte, al expandir tu vida de forma natural.", "_t")
t("spectre", "espectro", "talent type")
t("Turn into a spectre to move around the battlefield.", "Convertirse en un espectro para moverse alrededor del campo de batalla.", "_t")
