-- section "mod-tome/data/talents/chronomancy/spacetime-weaving.lua"

-- new text
t("Dimensional Step", "Paso dimensional", "talent name")
t("You do not have line of sight.", "No tienes línea de visión.", "logPlayer")
t("#Source# folds space with with #target#!", "#Source# dobla espacio con #target#!", "logCombat")
t("#Source#'s space-time folding with #target# fizzles!", "#Source#'s space-time pleging with #target# fizzles!", "logCombat")
t("#Source# resists #target#'s space-time folding!", "#Source# resiste el plegamiento espacial de #target#!", "logCombat")
t("%s's space-time folding fizzles!", "¡Las boquillas plegables del espacio-tiempo!%s", "logSeen")
t("%s emerges from a space-time rift!", "%s emerge de un grifo espacio-tiempo!", "logSeen")
t("Dimensional Shift", "Dimensional Desplazar", "talent name")
t("When you teleport you reduce the duration of a single detrimental effect by %d turns.", "Cuando te teletransportas reduces la duración de un solo efecto perjudicial por %d vueltas.", "tformat")
t("Wormhole", "Maldito", "talent name")
t("You can't place a wormhole entrance here.", "No puedes poner una entrada de agujeros de gusano aquí.", "logPlayer")
t("You can't place a wormhole exit here.", "No puedes poner un agujero de gusano aquí.", "logPlayer")
t("wormhole", "agujero de gusano", "_t")
t("trap", "trampa", "_t")
t("@Target@ moves onto the wormhole.", "@Target@ se mueve hacia el agujero de gusano.", "_t")
t("%s tries to enter the wormhole but a violent force pushes it back.", "%s intenta entrar en el agujero de gusano pero una fuerza violenta lo empuja hacia atrás.", "logSeen")
t("%s ignores the wormhole.", "%s ignora el agujero de gusano.", "logSeen")
t("Reality asserts itself and forces the wormhole shut.", "La realidad se afirma y obliga al agujero de gusano cerrado.", "logSeen")
t("%s folds the space between two points.", "%s dobla el espacio entre dos puntos.", "logSeen")
t("Phase Pulse", "Fase Pulse", "talent name")
t("Teleports you to up to %d tiles away, to a targeted location in line of sight.\n\t\tAt talent level 5 you may swap positions with a target creature.", "Te teletransporta hasta %d de distancia, a una ubicación específica en línea de la vista.\n\t\tAl nivel de talento 5 puedes cambiar posiciones con una criatura objetivo.", "tformat")
t("Teleports you to up to %d tiles away, to a targeted location in line of sight.\n\t\tAt talent level 5 you may swap positions with a target creature.", "Te teletransporta hasta %d de distancia, a una ubicación específica en línea de la vista.\n\t\tAl nivel de talento 5 puedes cambiar posiciones con una criatura objetivo.", "tformat")
t("You fold the space between yourself and a second point within a range of %d, creating a pair of wormholes.  Any creature stepping on either wormhole will be teleported near the other (radius %d accuracy).  \n\t\tThe wormholes will last %d turns and must be placed at least two tiles apart.\n\t\tThe chance of teleporting enemies will scale with your Spellpower.", "Tú dobla el espacio entre tú y un segundo punto dentro de una gama de %d, creando un par de agujeros de gusano. Cualquier criatura pisando o agujero de gusano será teletransportada cerca de la otra (actitud de %d radical).\nLos agujeros de gusano durarán turnos de %d y deben ser colocados al menos dos azulejos separados.\nLa posibilidad de teletransportar enemigos se escalará con tu poder.", "tformat")
t("Teleports you to up to %d tiles away, to a targeted location in line of sight.\n\t\tAt talent level 5 you may swap positions with a target creature.", "Te teletransporta hasta %d de distancia, a una ubicación específica en línea de la vista.\n\t\tAl nivel de talento 5 puedes cambiar posiciones con una criatura objetivo.", "tformat")
t("You fold the space between yourself and a second point within a range of %d, creating a pair of wormholes.  Any creature stepping on either wormhole will be teleported near the other (radius %d accuracy).  \n\t\tThe wormholes will last %d turns and must be placed at least two tiles apart.\n\t\tThe chance of teleporting enemies will scale with your Spellpower.", "Tú dobla el espacio entre tú y un segundo punto dentro de una gama de %d, creando un par de agujeros de gusano. Cualquier criatura pisando o agujero de gusano será teletransportada cerca de la otra (actitud de %d radical).\nLos agujeros de gusano durarán turnos de %d y deben ser colocados al menos dos azulejos separados.\nLa posibilidad de teletransportar enemigos se escalará con tu poder.", "tformat")
t("When you teleport you fire a pulse that jolts enemies out of phase in a radius of %d around both the start and the destination point. \n\t\tEach target has a %d%% chance per tile you travelled to be stunned, blinded, confused, or pinned for %d turns.", "Cuando te teletransportas disparas un pulso que sacude a los enemigos fuera de fase en un radio de %d alrededor tanto del comienzo como del punto de destino.\nCada objetivo tienes una %d %% oportunidad por baldosa que viajó para ser aturdido, cegado, confundido, o clavado para turnos %d.", "tformat")

------------------------------------------------
-- section "mod-tome/data/talents/chronomancy/speed-control.lua"

-- new text
t("Celerity", "Celeridad", "talent name")
t("When you move you gain %d%% movement speed for %d turns.  This effect stacks up to three times but can only occur once per turn.", "Cuando te mueves ganas %d%% de velocidad de movimiento para turnos %d. Este efecto acumula hasta tres veces pero sólo puedes ocurrir una vez por turno.", "tformat")
t("Time Dilation", "Tiempo Dilation", "talent name")
t("Haste", "Celeridad", "talent name")
t("Increases your global speed by %d%% for %d game turns.", "Aumenta tu velocidad global por %d%% para los turnos del juego %d.", "tformat")
t("Time Stop", "Tiempo Stop", "talent name")
t("#STEEL_BLUE#%s has stopped time!#LAST#", "#STEEL_BLUE# %s ha parado el tiempo.#", "logSeen")
t("When you use a non-instant chronomancy spell you gain %d%% attack, spell, and mind speed for %d turns.  This effect stacks up to three times but can only occur once per turn.", "Cuando usas un hechizo de cronomancia no instante ganas ataques %d %%, hechizo y velocidad mental para turnos %d. Este efecto acumula hasta tres veces pero sólo puedes ocurrir una vez por turno.", "tformat")
t("Gain %d turns.  During this time your damage will be reduced by %d%%.", "Gain %d vueltas. Durante este tiempo tu daño será reducido por %d %%.", "tformat")

