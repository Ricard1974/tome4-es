t("Speed", "Velocidad", "_t")
t("Increases global action speed by %d%%.", "Aumenta la velocidad de acción global por %d%%.", "tformat")
t("#Target# speeds up.", "#Target# acelera.", "_t")
t("+Fast", "+Rápido", "_t")
t("#Target# slows down.", "#Target# ralentiza.", "_t")
t("-Fast", "-Rápido", "_t")
t("slow", "ralentización", "effect subtype")
t("Slow", "Despacio", "_t")
t("Reduces global action speed by %d%%.", "Reduce la velocidad de acción global %d%%.", "tformat")
t("+Slow", "+Ralentizado", "_t")
t("-Slow", "-Ralentizado", "_t")
t("blind", "ciego", "effect subtype")
t("Blinded", "Cegado", "_t")
t("The target is blinded, unable to see anything.", "El objetivo estás ciego, incapaz de ver nada.", "_t")
t("#Target# loses sight!", "¡#Target# pierdes la visión!", "_t")
t("+Blind", "+Ceguera", "_t")
t("#Target# recovers sight.", "#Target# recupera la visión.", "_t")
t("-Blind", "-Ceguera", "_t")
t("Stoneskin", "Stoneskin", "_t")
t("The target's skin reacts to damage, granting %d armour.", "La piel del blanco reacciona al daño, otorgando %d armadura.", "tformat")
t("Thorny Skin", "Thorny Skin", "_t")
