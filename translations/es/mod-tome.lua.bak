section "mod-tome/data/chats/sorcerer-fight.lua"


-- new text
--[==[
t("High Sun Paladin Aeryn appears next to you!", "High Sun Paladin Aeryn appears next to you!", "logPlayer")
t("Spare me the small talk. I am here to stop you!", "Spare me the small talk. I am here to stop you!", "_t")
t("Why are you doing all that? You were supposed to help people!", "Why are you doing all that? You were supposed to help people!", "_t")
t("So you have decided to become the threat yourselves?", "So you have decided to become the threat yourselves?", "_t")
t("Us? Ah, no, we are merely instruments for the Master. We have planned for His return.", "Us? Ah, no, we are merely instruments for the Master. We have planned for His return.", "_t")
t("And 'He' would be...?", "And 'He' would be...?", "_t")
t("I *WILL* stop you! The world will not end today!", "I *WILL* stop you! The world will not end today!", "_t")
t("High Sun Paladin Aeryn", "High Sun Paladin Aeryn", "_t")
t("I am glad to have you at my side, my Lady. Let's hunt some wizards!", "I am glad to have you at my side, my Lady. Let's hunt some wizards!", "_t")
--]==]

