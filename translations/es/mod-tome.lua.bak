-- section "mod-tome/data/chats/mage-apprentice-quest.lua"

-- new text
t("...", "...", "_t")
t("What brings an apprentice mage out into the wilds?", "¿Qué trae a un aprendiz mago a los salvajes?", "_t")
t("I found this artefact; it looks powerful and arcane infused. Maybe it would be enough?", "Encontré este artefacto; parece poderoso y arcano infundido. ¿Tal vez sería suficiente?", "_t")
t("So you have enough magical items now?", "¿Ahora tienes suficientes objetos mágicos?", "_t")
t("Sorry I have to go!", "¡Lo siento, tengo que irme!", "_t")
t("Ahh, my story is a sad one... I should not trouble you with it, my friend.", "Mi historia es triste... No debería molestarte con eso, amigo mío.", "_t")
t("It is no trouble at all! Please tell me!", "¡No es ningún problema! ¡Por favor, dime!", "_t")
t("Ok, bye then!", "¡Bien, adiós entonces!", "_t")
t("Who are the people of Angolwen?", "¿Quién eres el pueblo de Angolwen?", "_t")
t("Ah yes, Angolwen, I have called it home for many years...", "Ah sí, Angolwen, lo he llamado a casa por muchos años...", "_t")
t("Well, good luck, bye!", "¡Buena suerte, adiós!", "_t")
t("I will keep that in mind!", "¡Lo tendré en cuenta!", "_t")
t("No way, bye!", "¡De ninguna manera, adiós!", "_t")
t("Well, I cannot use it anyway.", "Bueno, no puedo usarlo de todos modos.", "_t")
t("Oh! How could such a place be kept secret for so long... This is interesting indeed. Thank you for your trust!", "¡Oh! ¿Cómo podría un lugar tan secreto durante tanto tiempo... Esto es interesante. ¡Gracias por tu confianza!", "_t")
t("Thanks, and best luck in your studies!", "¡Gracias y buena suerte en tus estudios!", "_t")

