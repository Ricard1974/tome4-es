-- section "mod-tome/data/talents/spells/war-alchemy.lua"

-- new text
t("Heat", "Calor", "talent name")
t("Turn part of your target into fire, burning the rest for %0.2f fire damage over 8 turns.\n\t\tThe damage will increase with your Spellpower.", "Convertir parte de tu objetivo en fuego, quemar el resto para %0.2f daño de fuego en 8 vueltas. El daño aumentará con tu poder de pago.", "tformat")
t("Turn part of your target into fire, burning the rest for %0.2f fire damage over 8 turns.\n\t\tThe damage will increase with your Spellpower.", "Convertir parte de tu objetivo en fuego, quemar el resto para %0.2f daño de fuego en 8 vueltas. El daño aumentará con tu poder de pago.", "tformat")
t("Turn part of your target into fire, burning the rest for %0.2f fire damage over 8 turns.\n\t\tThe damage will increase with your Spellpower.", "Convertir parte de tu objetivo en fuego, quemar el resto para %0.2f daño de fuego en 8 vueltas. El daño aumentará con tu poder de pago.", "tformat")

