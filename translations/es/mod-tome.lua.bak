-- section "mod-tome/data/general/npcs/spider.lua"

-- new text
t("spiderkin", "arácnido", "entity type")
t("spider", "araña", "entity subtype")
t("Arachnophobia...", "Arachnofobia...", "_t")
t("giant spider", "araña gigante", "entity name")
t("A huge arachnid, it produces even bigger webs.", "Un arachnid enorme, produce telas aún más grandes.", "_t")
t("spitting spider", "araña escupidora", "entity name")
t("A huge arachnid, it sprays venom at its prey.", "Un arachnid enorme, rocía veneno en tu presa.", "_t")
t("chitinous spider", "araña chitina", "entity name")
t("A huge arachnid with a massive exoskeleton.", "Un enorme arcánido con un exoesqueleto masivo.", "_t")
t("gaeramarth", "gaeramarth", "entity name")
t("These cunning spiders terrorize those who enter the ever-growing borders of their lairs.  Those who encounter them rarely return.", "Estas arañas astutas aterrorizan a quienes entran en las fronteras cada vez mayores de sus guaridas. Aquellos que los encuentran rara vez regresan.", "_t")
t("ninurlhing", "ninurlhing", "entity name")
t("The air reeks with noxious fumes and the ground around it decays.", "El aire apesta con humos nocivos y el suelo que lo rodea decae.", "_t")
t("faerlhing", "faerlh", "entity name")
t("This spider seems to command the flow of mana, which pulses freely through its body.", "Esta araña parece ordenar el flujo de mana, que pulsa libremente a través de tu cuerpo.", "_t")
t("ungolmor", "ungolmor", "entity name")
t("Largest of all the spiderkin, its folds of skin seem nearly impenetrable.", "Más grande de toda la araña, sus pliegues de piel parecen casi impenetrables.", "_t")
t("losselhing", "perdedores", "entity name")
t("The air seems to freeze solid around this frigid spider.", "El aire parece congelarse sólido alrededor de esta araña frígida.", "_t")
t("weaver young", "joven", "entity name")
t("A tiny arachnid that phases in and out of reality.", "Un arachnid diminuto que se desvía dentro y fuera de la realidad.", "_t")
t("weaver patriarch", "weaver patriarca", "entity name")
t("A large blue arachnid with white markings on its thorax.  It shifts and shimmers as though only partially connected to the timeline.", "Un gran arachnid azul con marcas blancas en tu tórax. Cambia y brilla como aunque sólo parcialmente conectado a la línea de tiempo.", "_t")
t("weaver matriarch", "matriarca tejedora", "entity name")
t("A large dark blue arachnid with a shifting yellow and white pattern on its thorax.  It shifts and shimmers as though only partially connected to the timeline.", "Un gran arachnid azul oscuro con un patrón amarillo y blanco cambiante en tu tórax. Cambia y brilla como aunque sólo parcialmente conectado a la línea de tiempo.", "_t")
t("Ninandra, the Great Weaver", "Ninandra, el gran Weaver", "entity name")
t("A huge blue and white spiderkin whose form shifts and shimmers in and out of reality.  She spins the threads of fate and binds the destiny of all within her web.", "Una enorme araña azul y blanca cuya forma cambia y brilla dentro y fuera de la realidad. Ella gira los hilos del destino y une el destino de todos dentro de tu web.", "_t")

