t("Mobile Defense", "Mobile Defense", "_t")
t("stamina regeneration by %0.1f and ", "stamina regeneration by %0.1f and ", "tformat")
t("Increases %sdefense by %d.", "Increases %sdefense by %d.", "tformat")
