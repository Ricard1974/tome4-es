-- section "mod-tome/data/general/npcs/horror_aquatic.lua"

-- new text
t("horror", "horror", "entity type")
t("aquatic", "acuático", "entity subtype")
t("#LIGHT_BLUE#%s explodes into a huge bubble of air!", "#LIGHT_BLUE# %s explota en una enorme burbuja de aire!", "logSeen")
t("entrenched horror", "horror arraigado", "entity name")
t("This massive stony structure shifts and pulsates, its many long, thin tentacles probing the nearby water for food.", "Esta estructura pésima cambia y pulsa, sus muchos tentáculos largos y delgados que provocan el agua cercana para la comida.", "_t")
t("swarming horror", "horror enjambre", "entity name")
t("This tiny fish-like creature moves erratically, but is constantly surrounded by others of its kind.", "Esta pequeña criatura como peces se mueve erráticamente, pero estás constantemente rodeada por otros de tu tipo.", "_t")
t("ravenous horror", "horror terrible", "entity name")
t("A vile looking liquid flows from the teeth of this agile monster. It glides through the water towards you, spined fins jutting outwards.", "Un líquido de aspecto vil fluye de los dientes de este monstruo ágil. Se desliza a través del agua hacia ti, las aletas giradas juntando hacia fuera.", "_t")
t("boiling horror", "horror hirviendo", "entity name")
t("This frothing ball of water rages with an intense heat.", "Esta bola de agua fría se rabia con un calor intenso.", "_t")
t("swarm hive", "colmena enano", "entity name")
t("This titanic mass of flesh pulsates and churns as tiny monsters burst from its orifices.", "Esta masa titánica de carne pulsa y churns como pequeños monstruos salen de sus orificios.", "_t")
t("abyssal horror", "abismo horror", "entity name")
t("This pitch black form is shrouded in darkness. All you can make out are a pair of deep red eyes, hidden behind a mass of tentacles.", "Esta forma negra de lanzamiento estás rodeada de oscuridad. Todo lo que puedes hacer son un par de ojos rojos profundos, escondidos detrás de una masa de tentáculos.", "_t")

