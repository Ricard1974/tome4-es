t("#CRIMSON#%s roars with rage shaking off %d mental debuffs!", "#CRIMSON# %s rugidos con rabia sacudiendo %d ¡Debuffs mentales!", "logSeen")
t("Skirmisher", "o Skirmisher", "talent name")
t("Pride of the Orcs", "Pride de Orcs", "talent name")
t("yeek", "yeek", "talent type")
t("Dominant Will", "Dominant Voluntad", "talent name")
t("%s is immune to instakill and mind control effects!", "%s es inmune a los efectos del control de la mente e instamato!", "logSeen")
t("%s must be below 80%% of their max life to be controlled!", "%s debe estar por debajo del 80%% de tu vida máxima para ser controlada!", "logSeen")
t("%s resists the mental assault!", "%s resiste el asalto mental!", "logSeen")
t("Unity", "Unidad", "talent name")
t("Quickened", "Rápido", "talent name")
t("#RED#%s reacts immediately after taking severe wounds!#LAST#", "#RED# %s reacciona inmediatamente después de tomar heridas severas", "logSeen")
