-- section "mod-tome/data/timed_effects/physical.lua"

-- new text
t("acid", "ácido", "effect subtype")
t("Scoured", "Erosionado", "_t")
t("Scoured by natural acid, reducing their offensive power ratings by %d%%.", "Erosionado por ácido natural, reduciendo tu poder ofensivo en %d%%.", "tformat")
t("#Target#'s power is greatly reduced!", "¡El poder de #Target# se ha reducido enormemente!", "_t")
t("#Target# power has recovered.", "#Target# ha recuperado tu poder.", "_t")
t("tempo", "tempo", "effect subtype")
t("Relentless Tempo", "Tempo implacable", "_t")
t("All Resistance:  20%", "Todas las resistencias: 20%", "_t")
t("#Target# is gaining tempo.", "#Target# estás cogiendo ritmo.", "_t")
t("+Tempo", "+Ritmo", "_t")
t("#Target# loses their tempo.", "#Target# pierdes el ritmo.", "_t")
t("-Tempo", "-Ritmo", "_t")
t("concussion", "conmoción", "effect subtype")
t("Concussion", "Conmoción", "_t")
t("The target can't think straight, causing their actions to fail.", "El objetivo no puedes pensar con claridad, sus acciones fallan.", "tformat")
t("#Target#'s brain isn't quite working right!", "¡El cerebro de #Target# no funciona bien!", "_t")
t("+Concussion", "+Conmoción", "_t")
t("#Target# regains their concentration.", "#Target# recupera la concentración.", "_t")
t("-Concussion", "-Conmoción", "_t")
t("wound", "herida", "effect subtype")
t("cut", "corte", "effect subtype")
t("bleed", "sangrado", "effect subtype")
t("Bleeding", "Sangrado", "_t")
t("Huge cut that bleeds, doing %0.2f physical damage per turn.", "Gran corte sangrante que hace %0.2f de daño físico por turno.", "tformat")
t("#Target# starts to bleed.", "#Target# empieza a sangrar.", "_t")
t("+Bleeds", "+Sangra", "_t")
t("#Target# stops bleeding.", "#Target# deja de sangrar.", "_t")
t("-Bleeds", "-Sangra", "_t")
t("Deep Wound", "Herida profunda", "_t")
t("Huge cut that bleeds, doing %0.2f physical damage per turn and decreasing all heals received by %d%%.", "Gran corte que sangra haciendo %0.2f de daño y reduciendo curaciones recibidas en %d%%.", "tformat")
t("#Target# is cut deeply.", "#Target# estás profundamente cortado.", "_t")
t("+Deep Wounds", "+Heridas profundas", "_t")
t("#Target#'s deep wound closes.", "La herida profunda de #Target# se cierra.", "_t")
t("-Deep Wounds", "-Heridas profundas", "_t")
t("nature", "naturaleza", "effect subtype")
t("healing", "curación", "effect subtype")
t("regeneration", "regeneración", "effect subtype")
t("Regeneration", "Regeneración", "_t")
t("A flow of life spins around the target, regenerating %0.2f life per turn.", "Un flujo de vida rodea al objetivo, regenerando %0.2f de vida por turno.", "tformat")
t("#Target# starts regenerating health quickly.", "#Target# empieza a regenerar vida rápidamente.", "_t")
t("+Regen", "Regeneración", "_t")
t("#Target# stops regenerating health quickly.", "#Target# deja de regenerar vida.", "_t")
t("-Regen", "-Regen", "_t")
t("poison", "veneno", "effect subtype")
t("Poison", "Veneno", "_t")
t("The target is poisoned, taking %0.2f nature damage per turn.", "El objetivo estás envenenado, tomando %0.2f daño natural por turno.", "tformat")
t("#Target# is poisoned!", "¡#Target# estás envenenado!", "_t")
t("+Poison", "+Veneno", "_t")
t("#Target# stops being poisoned.", "El sargento deja de ser envenenado. #Target#", "_t")
t("-Poison", "-Veneno", "_t")
t("pin", "inmovilización", "effect subtype")
t("Spydric Poison", "Veneno arácnido", "_t")
t("The target is poisoned, taking %0.2f nature damage per turn and unable to move (but can otherwise act freely).", "El objetivo estás envenenado, tomando %0.2f daño natural por turno y no puedes moverse (pero puedes actuar libremente).", "tformat")
t("#Target# is poisoned and cannot move!", "#Target# estás envenenado y no puedes moverse!", "_t")
t("+Spydric Poison", "+ Veneno de Spydric", "_t")
t("#Target# is no longer poisoned.", "#Target# ya no estás envenenado.", "_t")
t("-Spydric Poison", "-Poison Spydric", "_t")
t("Insidious Poison", "Veneno insidioso", "_t")
t("The target is poisoned, taking %0.2f nature damage per turn and decreasing all heals received by %d%%.", "El objetivo estás envenenado, tomando %0.2f daño natural por turno y disminuyendo todos los sanes recibidos por %d%%.", "tformat")
t("+Insidious Poison", "+ veneno insidioso", "_t")
t("-Insidious Poison", "- Insidiosa veneno", "_t")
t("Crippling Poison", "Veneno paralizante", "_t")
t("The target is poisoned and sick, doing %0.2f nature damage per turn. Each time it tries to use a talent there is %d%% chance of failure.", "El objetivo estás envenenado y enfermo, haciendo %0.2f daño natural por turno. Cada vez que trata de usar un talento hay %d%% de probabilidad de fracaso.", "tformat")
t("+Crippling Poison", "+ Veneno para la limpieza", "_t")
t("-Crippling Poison", "-Crippling Poison", "_t")
t("Numbing Poison", "Veneno entumecedor", "_t")
t("The target is poisoned and sick, doing %0.2f nature damage per turn. All damage it does is reduced by %d%%.", "El objetivo estás envenenado y enfermo, haciendo %0.2f daño natural por turno. Todo el daño que haces se reduce por %d%%.", "tformat")
t("+Numbing Poison", "+ venenoso", "_t")
t("-Numbing Poison", "- Envenenamiento de los nervios", "_t")
t("earth", "tierra", "effect subtype")
t("Stoning Poison", "Veneno petrificante", "_t")
t("The target is taking %0.2f nature damage per turn from a potent earth-based poison.  In %d more turn(s), or when the poison has run its course (%d%% chance), the target will be turned to stone for %d turns.", "El objetivo estás tomando %0.2f daño natural por giro de un potente veneno terrestre. En %d más turnos, o cuando el veneno ha corrido tu curso ( %d %% oportunidad), el objetivo se convertirá en piedra para %d vueltas.", "tformat")
t("#Target# is infused with stone poison!", "#Target# se infunde con veneno de piedra!", "_t")
t("+Stoning Poison", "+ Veneno de lapidación", "_t")
t("#Target# is free of the stone poison!", "#Target# estás libre del veneno de piedra!", "_t")
t("-Stoning Poison", "- Veneno de lapidación", "_t")
t("#GREY#%s looks stony for a moment, but resists the transformation.", "#GREY# %s se ve pésimo por un momento, pero resiste la transformación.", "logSeen")
t("fire", "fuego", "effect subtype")
t("Burning", "Ardiendo", "_t")
t("The target is on fire, taking %0.2f fire damage per turn.", "El objetivo estás en llamas, tomando %0.2f daño a turno.", "tformat")
t("#Target# is on fire!", "¡#Target# estás en llamas!", "_t")
t("+Burn", "+Quemadura", "_t")
t("#Target# stops burning.", "#Target# deja de arder.", "_t")
t("-Burn", "-Quemadura", "_t")
t("stun", "aturdimiento", "effect subtype")
t("Burning Shock", "Descarga ardiente", "_t")
t("The target is on fire, taking %0.2f fire damage per turn, reducing damage by 50%%, putting 4 random talents on cooldown and reducing movement speed by 50%%. While flameshocked talents cooldown twice as slow.", "El objetivo estás en llamas, tomando %0.2f daño al fuego por turno, reduciendo el daño en un 50%%, poniendo 4 talentos al azar en la refrigeración y reduciendo la velocidad del movimiento en un 50%%. Mientras los talentos llamativos se enfrían el doble de lento.", "tformat")
t("#Target# is stunned by the burning flame!", "#Target# es aturdido por la llama ardiente!", "_t")
t("+Burning Shock", "Impacto Ardiente", "_t")
t("#Target# is not stunned anymore.", "#Target# ya no estás aturdido.", "_t")
t("-Burning Shock", "-Shock ardiente", "_t")
t("Stunned", "Aturdido", "_t")
t("The target is stunned, reducing damage by 50%%, putting 3 random talents on cooldown and reducing movement speed by 5", "El objetivo es aturdido, reduciendo el daño en 50%%, poniendo 3 talentos aleatorios en la refrigeración y reduciendo la velocidad del movimiento en 5", "tformat")
t("#Target# is stunned!", "¡#Target# estás aturdido!", "_t")
t("+Stunned", "+Aturdido", "_t")
t("-Stunned", "-Aturdido", "_t")
t("disarm", "desarme", "effect subtype")
t("Disarmed", "Desarmado", "_t")
t("The target is maimed, unable to correctly wield a weapon.", "El objetivo estás mutilado, incapaz de manejar correctamente un arma.", "_t")
t("#Target# is disarmed!", "¡#Target# estás desarmado!", "_t")
t("+Disarmed", "+Desarmado", "_t")
t("#Target# rearms.", "#Target# se rearma.", "_t")
t("-Disarmed", "-Desarmado", "_t")
t("grapple", "presa", "effect subtype")
t("Constricted", "Constreñido", "_t")
t("The target is constricted, preventing movement and making it suffocate (loses %0.2f air per turn).", "El objetivo estás restringido, previniendo el movimiento y haciéndolo sofocado (pérdida %0.2f aire por turno).", "tformat")
t("#Target# is constricted!", "#Target# estás restringido!", "_t")
t("+Constricted", "Constreñido", "_t")
t("#Target# is free to breathe.", "#Target# es libre de respirar.", "_t")
t("-Constricted", "-Constricted", "_t")
t(" was constricted to death by %s.", "fue restringido a la muerte por %s.", "tformat")
t("Dazed", "Atontado", "_t")
t("The target is dazed, rendering it unable to move, halving all damage done, defense, saves, accuracy, spell, mind and physical power. Any damage will remove the daze.", "El objetivo estás aturdido, lo que lo haces incapaz de moverse, aboliendo todo daño hecho, defensa, salva, precisión, hechizo, mente y poder físico. Cualquier daño eliminará la daze.", "_t")
t("#Target# is dazed!", "¡#Target# estás atontado!", "_t")
t("+Dazed", "Aturdido", "_t")
t("#Target# is not dazed anymore.", "#Target# ya no estás atónito.", "_t")
t("-Dazed", "Aturdimiento", "_t")
t("evade", "evasión", "effect subtype")
t("Evasion", "Evasión", "_t")
t("The target has %d%% chance to evade melee and ranged attacks", "El objetivo tiene %d% de oportunidad de evadir el cuerpo a cuerpo y los ataques", "tformat")
t(" and gains %d defense", "y ganancias %d defensa", "tformat")
t("#Target# tries to evade attacks.", "#Target# intenta evadir los ataques.", "_t")
t("+Evasion", "+Evasión", "_t")
t("#Target# is no longer evading attacks.", "#Target# ya no estás evadiendo ataques.", "_t")
t("-Evasion", "-Evasión", "_t")
