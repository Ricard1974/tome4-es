t("Dark Hair 4", "Dark Hair 4", "_t")
t("Dark Hair 5", "Dark Hair 5", "_t")
t("Blond Hair 1", "Blond Hair 1", "_t")
t("Blond Hair 2", "Blond Hair 2", "_t")
t("Blond Hair 3", "Blond Hair 3", "_t")
