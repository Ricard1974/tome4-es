-- section "mod-tome/data/general/npcs/troll.lua"

-- new text
t("giant", "gigante", "entity type")
t("troll", "trol", "entity subtype")
t("forest troll", "bosque troll", "entity name")
t("Green-skinned and ugly, this massive humanoid glares at you, clenching wart-covered green fists.", "De piel verde y fea, este enorme humanoide te llama, puños verdes cubiertos de verrugas.", "_t")
t("stone troll", "piedra troll", "entity name")
t("A giant troll with scabrous black skin. With a shudder, you notice the belt of dwarf skulls around his massive waist.", "Un troll gigante con piel negra escabrosa. Con un estremecimiento, nota el cinturón de cráneos enanos alrededor de tu cintura masiva.", "_t")
t("cave troll", "troll de cueva", "entity name")
t("This huge troll wields a massive spear and has a disturbingly intelligent look in its piggy eyes.", "Este enorme troll dobla una lanzas masiva y tienes una mirada inquietantemente inteligente en sus ojos perritos.", "_t")
t("mountain troll", "trol de montaña", "entity name")
t("A large and athletic troll with an extremely tough and warty hide.", "Un trol grande y atlético con un escondite extremadamente duro y caluroso.", "_t")
t("mountain troll thunderer", "montaña troll trueno", "entity name")
t("patchwork troll", "parche troll", "entity name")
t("A disgusting and mismatched construct of necromantically-enhanced troll bits and shattered weapons. Confused and furious, it rends and shatters its surroundings with impossible strength, moving with speed found nowhere in nature.", "Una construcción repugnante y desajustada de troll bits necromantically-enhanced y armas destrozadas. Confuso y furioso, rendía y destroza tu entorno con fuerza imposible, moviéndose con velocidad no encontrada en la naturaleza.", "_t")
t("Forest Troll Hedge-Wizard", "Mago Seto Trol del Bosque", "entity name")
t("This old-looking troll glares at you with malice. His muscles appear atrophied, but a certain power surrounds him nonetheless.", "Este viejo troll te llama con malicia. Sus músculos parecen atrofiados, pero cierto poder lo rodea sin embargo.", "_t")

