-- new text
t("immovable", "extraíble", "entity type")
t("jelly", "#", "entity subtype")
t("A strange blob on the dungeon floor.", "Un tipo extraño en el piso de la mazmorra.", "_t")
t("green jelly", "gelatina verde", "entity name")
t("A strange green blob on the dungeon floor.", "Un extraño bloque verde en el piso de la mazmorra.", "_t")
