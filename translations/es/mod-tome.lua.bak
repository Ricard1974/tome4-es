-- section "mod-tome/data/chats/arena-unlock.lua"

-- new text
t("Interesting. Tell me more about that Arena.", "Interesante. Cuéntame más sobre esa Arena.", "_t")
t("I am strong! What do you have to offer?", "¡Soy fuerte! ¿Qué tienes que ofrecer?", "_t")
t("I don't accept deals from shady hooded men.", "No acepto ofertas de hombres encapuchados.", "_t")
t("I am ready for battle. Let's go!", "Estoy listo para la batalla. ¡Vamos!", "_t")
t("I don't have time for games, Cornac.", "No tengo tiempo para juegos, Cornac.", "_t")
t("We'll see. [Leave]", "Ya veremos. [Leave]", "_t")
t("Sounds like fun. I'm ready!", "Suena divertido. ¡Estoy listo!", "_t")
t("Wait. I am not ready yet.", "Espera. Aún no estoy listo.", "_t")
t("#LIGHT_GREEN#*The man quietly walks away, after making you a gesture to follow him*", "#LIGHT_GREEN#*El hombre se aleja tranquilamente, después de hacerte un gesto para seguirlo*", "_t")
t("[Follow him]", "[Síguelo]", "_t")
t("Get ready!", "¡Prepárate!", "_t")
t("Defeat all three enemies!", "¡Derrota a los tres enemigos!", "_t")
t("I will. Farewell for now.", "Lo haré. Adiós por ahora.", "_t")
t("exit to Derth", "salida a Derth", "_t")
t("Select the party member to receive the +2 generic talent points:", "Seleccione el miembro del partido para recibir los +2 puntos de talento genéricos:", "_t")
t("#WHITE#I see. I will be waiting... #YELLOW#But not for long.", "Ya veo. Estaré esperando... Pero no por mucho tiempo.", "_t")
t("Yes, tell me more.", "Sí, dime más.", "_t")
t("No, see you.", "No, nos vemos.", "_t")
t("Let's go, Cornac.", "Vamos, Cornac.", "_t")
t("Just a minute. I have to prepare my equipment.", "Un momento. Tengo que preparar mi equipo.", "_t")

