-- section "mod-tome/data/general/npcs/horror_temporal.lua"

-- new text
t("horror", "horror", "entity type")
t("temporal", "temporal", "entity subtype")
t("dredgling", "dragado", "entity name")
t("A small pink-skinned humanoid with large bulbous eyes.", "Un pequeño humanoide de piel rosa con grandes ojos bulbosos.", "_t")
t("dredge", "dredge", "entity name")
t("A hulking pink-skinned creature with long arms as thick as tree trunks.  It drags its knuckles on the ground as it lumbers toward you.", "Una criatura de piel rosa con brazos largos tan gruesos como troncos de árboles. Arrastra sus nudillos en el suelo mientras se alumbra hacia ti.", "_t")
t("dredge captain", "capitán de dragado", "entity name")
t("A thin pink-skinned creature with long spindly arms.  Half its body is old and wrinkly, and the other half appears quite young.", "Una criatura delgada de piel rosa con brazos largos. La mitad de tu cuerpo es viejo y arrugado, y la otra mitad parece bastante joven.", "_t")
t("temporal stalker", "acosador temporal", "entity name")
t("A slender metallic monstrosity with long claws in place of fingers, and razor-sharp teeth.", "Una monstruosidad metálica esbelta con garras largas en lugar de los dedos, y dientes de afeitado.", "_t")
t("void horror", "horror", "entity name")
t("It looks like a hole in spacetime, but you get the impression it's somehow more than that.", "Parece un agujero en tiempo espacial, pero tienes la impresión de que es algo más que eso.", "_t")
t("%s has collapsed in upon itself.", "%s se ha colapsado sobre sí mismo.", "logSeen")

